                 (∀ (i : ι), u i ≠ (L i).one) →\n                              (∀ (i : ι), (L i).escapeNorm (↑(A i)) (u i) = 1 / ↑(Nu i)) →\n                                (∀ (i : ι),\n                                    ∀ x ∈ A i,\n                                      x ≠ (L i).one → (L i).escapeNorm (↑(A i)) (u i) ≤ (L i).escapeNorm (↑(A i)) x) →\n                                  (∀ (n : ℕ), ∀ᶠ (i : ι) in ↑U, n < Nu i) →\n                                    ∀ (π : DirectedCycles.LocalGroupHom (DirectedCycles.localUltraAlgebra (↑U) G L) Q)\n                                      (V : Set H),\n                                      (∀ O ∈ nhds Q.one, ∃ k, 1 ≤ k ∧ ∀ (x : H), (∀ n ≤ k, Q.PowerIn V x n) → x ∈ O) →\n                                        (∀ (x : H) (q : Q.PowerSequence x), (∀ (n : ℕ), q.power n ∈ V) → x = Q.one) →\n                                          (∀ z ∈ DirectedCycles.localUltraSet (↑U) G fun i => ↑(A i), π.toFun z ∈ V) →\n                                            ∀ {r δ : ℝ},\n                                              0 < r →\n                                                0 < δ →\n                                                  δ ≤ 1 →\n                                                    10 * r < Y.radius →\n                                                      (∀ z ∈ DirectedCycles.localUltraSet (↑U) G fun i => ↑(A i),\n                                                          π.toFun z ∈\n                                                            ↑Y.chart '' Metric.closedBall 0 (1001 / 1000 * r)) →\n                                                        (∀ (z : DirectedCycles.LocalUltraproduct (↑U) G),\n                                                            π.toFun z ∈ ↑Y.chart '' Metric.ball 0 r →\n                                                              z ∈ DirectedCycles.localUltraSet (↑U) G fun i => ↑(A i)) →\n                                                          (∀ z ∈ DirectedCycles.localUltraSet (↑U) G fun i => ↑(B i),\n                                                              π.toFun z ∈ ↑Y.chart '' ⋯) →\n                                                            (∀ (z : DirectedCycles.LocalUltraproduct (↑U) G),\n                                                                π.toFun z ∈ ⋯ →\n                                                                  z ∈\n                                                                    DirectedCycles.localUltraSet (↑U) G fun i =>\n                                                                      ↑(B i)) →\n                                                              ∀ (φ : ℝ → H), φ 0 = Q.one → ContinuousAt φ 0 → ⋯"}
