ycles.elementClosure a)) (C : DirectedCycles.Cycle (DirectedCycles.CayleyDigraph S))\n        (s : Fin C.length → G)\n        (hstep :\n          ∀ (i : Fin C.length),\n            C.vertex ((finRotate C.length) i) =\n              C.vertex i * (QuotientGroup.mk' (DirectedCycles.elementClosure a)) (s i))\n        (D : ℕ) (X : DirectedCycles.SeparatedLiftInput a S C s hstep (fun z => t ↑z) D),\n        2 * D + 2 ≤ orderOf ((QuotientGroup.mk' (DirectedCycles.elementCommutators a)) a) →\n          ∀ (i j : Fin C.length),\n            i ≠ j →\n              ∀ (u u' : ℕ),\n                u ≤ D →\n                  u' ≤ D →\n                    ∀ (x y : G),\n                      (QuotientGroup.mk' (DirectedCycles.elementCommutators a)) x =\n                          DirectedCycles.residuePower ((QuotientGroup.mk' (DirectedCycles.elementCommutators a)) a)\n                              (X.residues i + ↑u) *\n                            (QuotientGroup.mk' (DirectedCycles.elementCommutators a))\n                              (List.take (↑i) (List.ofFn s)).prod →\n                        (QuotientGroup.mk' (DirectedCycles.elementCommutators a)) y =\n                            DirectedCycles.residuePower ((QuotientGroup.mk' (DirectedCycles.elementCommutators a)) a)\n                                (X.residues j + ↑u') *\n                              (QuotientGroup.mk' (DirectedCycles.elementCommutators a))\n                                (List.take (↑j + 1) (List.ofFn s)).prod →\n                          ∀ (z : I), y ≠ x * t z"}
