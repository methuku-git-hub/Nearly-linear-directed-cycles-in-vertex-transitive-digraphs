      {x | (L i).escapeNorm (↑(A i)) x < r}) →\n                  ∀ {H : Type u_3} [inst : Group H] [inst_1 : TopologicalSpace H] [IsTopologicalGroup H] [T2Space H]\n                    (π :\n                      DirectedCycles.LocalGroupHom (DirectedCycles.localUltraAlgebra (↑U) G L)\n                        (DirectedCycles.LocalGroupAlgebra.ofGroup H))\n                    (V : Set H),\n                    IsCompact V →\n                      (∀ (y : H), (∀ (n : ℕ), y ^ n ∈ V) → y = 1) →\n                        (∀ z ∈ DirectedCycles.localUltraSet (↑U) G fun i => ↑(A i), π.toFun z ∈ V) →\n                          ∀ {Q T W : Set H} (hQ : DirectedCycles.LocalNormalSet Q T) (hW1 : 1 ∈ W) (hWi : W⁻¹ = W)\n                            (hW6 : W ^ 6 ⊆ T),\n                            IsOpen W →\n                              (∀ z ∈ DirectedCycles.localUltraSet (↑U) G fun i => ↑(P i), π.toFun z ∈ Q) →\n                                ∃ J η,\n                                  1 ≤ J ∧\n                                    0 < η ∧\n                                      ∃ D B,\n                                        (∀ (i : ι),\n                                            DirectedCycles.IsLocalFiniteApproximateGroup (L i) J (B i) ∧\n                                              η * ↑(A i).card ≤ ↑(B i).card ∧\n                                                (∀ n ≤ 200, (L i).wordPower (↑(B i)) n ⊆ (D i).small) ∧\n                                                  DirectedCycles.IsLocalFiniteApproximateGroup (D i).algebra J\n                                                      ((D i).finiteImage (B i)) ∧\n                                                    η * ↑(A i).card ≤ ↑((D i).finiteImage (B i)).card * ↑(P i).card) ∧\n                                          ∃ F,\n                                            ∀\n                                              (a :\n                                                ↑(DirectedCycles.LocalGroupAlgebra.CentralQuotientData.ultraproduct U G\n                                                      L (fun i => ↑(P i)) D).small),\n                                              F.toFun\n                                                    ((DirectedCycles.LocalGroupAlgebra.CentralQuotientData.ultraproduct\n                                                          U G L (fun i => ↑(P i)) D).project\n                                                      a) =\n                                                  (hQ.quotientAlgebra hW1 hWi hW6).one ↔\n                                                π.toFun ↑a ∈ Q"}
