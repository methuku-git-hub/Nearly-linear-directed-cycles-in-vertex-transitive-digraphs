[inst : Group G] [inst_1 : TopologicalSpace G] (D : DirectedCycles.GleasonMetricData G)\n  [IsTopologicalGroup G] [LocallyCompactSpace G] {r : ℝ},\n  (∀ (g h : G) (n : ℕ), 0 < n → ↑n * D.gauge g ≤ r → ↑n * D.gauge h ≤ r → dist (g ^ n) (h ^ n) ≤ 2 * ↑n * dist g h) →\n    r ≤ 1 / (8 * D.constant) →\n      ∀ (φ ψ : DirectedCycles.OneParameter G) {L₁ L₂ : ℝ},\n        0 ≤ L₁ →\n          (∀ (t : ℝ), D.gauge (φ.eval t) ≤ L₁ * |t|) →\n            (∀ (t : ℝ), D.gauge (ψ.eval t) ≤ L₂ * |t|) →\n              0 ≤ L₂ →\n                ∀ {T : ℝ},\n                  0 ≤ T →\n                    (L₁ + L₂) * T ≤ r →\n                      have this := D.compatibleMetric;\n                      TendstoUniformlyOn (fun n t => φ.productApprox ψ t n) (φ.productLimit ψ) Filter.atTop\n                        {t | |t| ≤ T}"}
