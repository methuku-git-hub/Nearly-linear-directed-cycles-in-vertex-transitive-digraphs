DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"direct_constants":["Fintype","DirectedCycles.LocalGroupAlgebra","Eq","Real","Finset","Membership.mem","SetLike.instMembership","Finset.instSetLike","DirectedCycles.LocalGroupAlgebra.one","DirectedCycles.LocalGroupAlgebra.factorBump","Eq.ndrec","Eq.rec","Eq.refl"],"kind":"theorem","module":"DirectedCycles.LocalFactorBump","name":"DirectedCycles.LocalGroupAlgebra.factorBump.congr_simp","type":"∀ {G : Type u_1} [inst : Fintype G] (L L_1 : DirectedCycles.LocalGroupAlgebra G) (e_L : L = L_1) (d d_1 : G → ℝ),\n  d = d_1 →\n    ∀ (A A_1 : Finset G) (e_A : A = A_1) (hA : L.one ∈ A) (r r_1 : ℝ),\n      r = r_1 → ∀ (x x_1 : G), x = x_1 → L.factorBump d A hA r x = L_1.factorBump d_1 A_1 ⋯ r_1 x_1"}
DECLARATION_JSON {"axioms":["propext","Classical.choice","Quot.sound"],"direct_constants":["Fintype","DirectedCycles.LocalGroupAlgebra","Real","Finset","Membership.mem","SetLike.instMembership","Finset.instSetLike","DirectedCycles.LocalGroupAlgebra.one","Eq","DirectedCycles.LocalGroupAlgebra.factorBump","Max.max","Real.instMax","HSub.hSub","instHSub","Real.instSub","OfNat.ofNat","One.toOfNat1","Real.instOne","HDiv.hDiv","instHDiv","DivInvMonoid.toDiv","Real.instDivInvMonoid","DirectedCycles.LocalGroupAlgebra.factorDistance","Zero.toOfNat0","Real.instZero","Eq.refl"],"kind":"theorem","module":"DirectedCycles.LocalFactorBump","name":"DirectedCycles.LocalGroupAlgebra.factorBump.eq_1","type":"∀ {G : Type u_1} [inst : Fintype G] (L : DirectedCycles.LocalGroupAlgebra G) (d : G → ℝ) (A : Finset G) (hA : L.one ∈ A)\n  (r : ℝ) (x : G), L.factorBump d A hA r x = max (1 - L.factorDistance d A hA x / r) 0"}
