 r ∧\n            ∀ (G : Type u_1) [inst : Group G] [Fintype G] [DecidableEq G] (A : Finset G),\n              DirectedCycles.IsStrongFiniteApproximateGroup K A →\n                (∀ (g : G), DirectedCycles.escapeNorm (↑A) g = 0 → g = 1) →\n                  (∃ g ∈ A, g ≠ 1) →\n                    ∃ u ∈ A,\n                      u ≠ 1 ∧\n                        ∃ N,\n                          0 < N ∧\n                            u ^ N ∉ ↑A ∧\n                              (∀ i < N, u ^ i ∈ ↑A) ∧\n                                let W := DirectedCycles.escapeSublevel (↑A) r;\n                                ∃ (hW1 : 1 ∈ W) (hWi : W⁻¹ = W),\n                                  ∃ V,\n                                    ∃ (hP : DirectedCycles.LocalNormalSet (DirectedCycles.shortPowerProgression u N) V)\n                                      (hW6 : W ^ 6 ⊆ V),\n                                      ∃ T,\n                                        IsApproximateSubgroup ↑J ↑T ∧\n                                          d * ↑A.card ≤ ↑T.card ∧\n                                            ↑T ^ 200 ⊆ W ∧\n                                              DirectedCycles.IsLocalFiniteApproximateGroup\n                                                  (hP.quotientAlgebra hW1 hWi hW6) (2 * J)\n                                                  (hP.finiteWindowImage hW1 hWi hW6 T) ∧\n                                                d * ↑A.card ≤ ↑(hP.finiteWindowImage hW1 hWi hW6 T).card * ↑(2 * N - 1)"}
