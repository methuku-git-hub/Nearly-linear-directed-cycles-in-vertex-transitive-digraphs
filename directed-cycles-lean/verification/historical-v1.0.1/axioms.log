c n : ℕ),\n        Group.rank G ≤ r →\n          Group.nilpotencyClass G ≤ c →\n            c ≤ n →\n              8 * (n + 1) + 4 <\n                  Nat.card\n                    (↥(DirectedCycles.elementClosure xs.prod) ⧸\n                      (DirectedCycles.elementCommutators xs.prod).subgroupOf (DirectedCycles.elementClosure xs.prod)) →\n                DirectedCycles.elementClosure xs.prod ≠ ⊤ →\n                  ∀ (bq bl eps : ℝ),\n                    0 < bq →\n                      0 < bl →\n                        0 ≤ eps →\n                          DirectedCycles.CayleySpanningBound (G ⧸ DirectedCycles.elementClosure xs.prod) (n + 1) bq\n                              (eps / (↑(DirectedCycles.auxiliaryIndexExponent r c n) + 1)) →\n                            DirectedCycles.LayerSpanningBound (↥(DirectedCycles.elementCommutators xs.prod)) (n + 1) bl\n                                eps →\n                              (∀ (U : Subgroup ↥(DirectedCycles.elementCommutators xs.prod)),\n                                  DirectedCycles.LayerCycleLowerBound (↥U) bl eps) →\n                                DirectedCycles.StronglyConnected (DirectedCycles.CyclicLayerDigraph S) →\n                                  have k := DirectedCycles.auxiliaryIndexExponent r c n + 1;\n                                  have b :=\n                                    min (bl / (4 * ↑(DirectedCycles.auxiliaryIndexConstant r c n)) * bq ^ k)\n                                      (bl / 4 * bq);\n                                  ∃ L,\n                                    b * ↑T * ↑(Nat.card G) ^ (1 - eps) ≤ ↑L.length ∧\n                                      (DirectedCycles.AbovePrimeCutoff G (n + 1) →\n                                        ∀ (z : ZMod T), DirectedCycles.SpansTruncation (n + 1) (L.layerCoordinates z))"}
