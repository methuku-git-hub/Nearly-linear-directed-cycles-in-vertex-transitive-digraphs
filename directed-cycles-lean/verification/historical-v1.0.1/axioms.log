 (ν : I → ZMod h) (src dst : C → I) (bad : C → Finset (ZMod h)),\n          (∀ (c : C), src c ≠ dst c) →\n            (∀ (c : C), (bad c).card ≤ 2 * D + 1) →\n              (∀ (i : I), {c | src c = i ∨ dst c = i}.card ≤ 2 * q) →\n                ∃ v,\n                  (∀ (i : I),\n                      (h + 7) / 8 ≤ (v i - v (σ i) - (↑D + ν i)).val ∧\n                        (v i - v (σ i) - (↑D + ν i)).val ≤ h - 2 * D - 2) ∧\n                    ∀ (c : C), v (dst c) - v (src c) ∉ bad c"}
