{A B : Finset G}\n  {K : ℕ},\n  L.one ∈ A →\n    (∀ x ∈ A, L.inv x ∈ A) →\n      L.AllProductsDefined (↑A) 200 →\n        ∀ (C : ℝ),\n          (∀ x ∈ A,\n              ∀ y ∈ A,\n                ∀ (z : G), L.mulRel x y z → L.escapeNorm (↑A) z ≤ C * (L.escapeNorm (↑A) x + L.escapeNorm (↑A) y)) →\n            (∀ (x : G), (∀ (j : ℕ), 1 ≤ j → j ≤ 1000 → L.PowerIn (L.wordPower (↑A) 100) x j) → x ∈ A) →\n              DirectedCycles.IsLocalFiniteApproximateGroup L K B →\n                L.wordPower (↑B) 200 ⊆ ↑A →\n                  have H := {x | L.escapeNorm (↑A) x = 0};\n                  ∃ (W : L.NormalSubgroupWindow H (L.setMul H ↑A)),\n                    DirectedCycles.IsLocalFiniteApproximateGroup (W.congruence hd ⋯).algebra K (W.finiteImage hd ⋯ B) ∧\n                      (W.congruence hd ⋯).algebra.IsNSS Set.univ ∧\n                        (W.congruence hd ⋯).algebra.DivisionClosed ∧\n                          (W.congruence hd ⋯).algebra.Reversible ∧\n                            B.card ≤ (W.finiteImage hd ⋯ B).card * (DirectedCycles.localZeroEscapeFinset L A).card"}
