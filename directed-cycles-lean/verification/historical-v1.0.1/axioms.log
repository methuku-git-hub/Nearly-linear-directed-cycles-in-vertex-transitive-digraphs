(i : ι) in ↑U, n < Nu i) →\n                                ∀\n                                  (π :\n                                    DirectedCycles.LocalGroupHom (DirectedCycles.localUltraAlgebra (↑U) G L)\n                                      (DirectedCycles.LocalGroupAlgebra.ofGroup H))\n                                  (V : Set H),\n                                  IsCompact V →\n                                    (∀ (x : H), (∀ (n : ℕ), x ^ n ∈ V) → x = 1) →\n                                      (∀ z ∈ DirectedCycles.localUltraSet (↑U) G fun i => ↑(A i), π.toFun z ∈ V) →\n                                        ∀ {R r δ : ℝ},\n                                          0 < r →\n                                            0 < δ →\n                                              δ ≤ 1 →\n                                                1001 / 1000 * r < R →\n                                                  Set.InjOn DirectedCycles.lieExponential (Metric.ball 0 R) →\n                                                    (∀ z ∈ DirectedCycles.localUltraSet (↑U) G fun i => ↑(A i),\n                                                        π.toFun z ∈\n                                                          DirectedCycles.lieExponential ''\n                                                            Metric.closedBall 0 (1001 / 1000 * r)) →\n                                                      (∀ (z : DirectedCycles.LocalUltraproduct (↑U) G),\n                                                          π.toFun z ∈ DirectedCycles.lieExponential '' Metric.ball 0 r →\n                                                            z ∈ DirectedCycles.localUltraSet (↑U) G fun i => ↑(A i)) →\n                                                        (∀ z ∈ DirectedCycles.localUltraSet (↑U) G fun i => ↑(B i),\n                                                            π.toFun z ∈ ⋯) →\n                                                          (∀ (z : DirectedCycles.LocalUltraproduct (↑U) G),\n                                                              ⋯ →\n                                                                z ∈\n                                                                  DirectedCycles.localUltraSet (↑U) G fun i => ↑(B i)) →\n                                                            ∀ (φ : ℝ → H), φ 0 = 1 → ⋯"}
