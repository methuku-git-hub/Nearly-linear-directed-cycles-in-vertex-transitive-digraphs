 : LieGroup (modelWithCornersSelf ℝ E) (↑⊤) H],\n  (∀ (i : ι), (L i).DivisionClosed) →\n    (∀ (i : ι), (L i).Reversible) →\n      ∀ (B : (i : ι) → Set (G i)) (g u : (i : ι) → G i) (N₁ M₁ N₀ M₀ : ι → ℕ)\n        (p : (i : ι) → (L i).PowerSegment (g i) (M₁ i)) (q : (i : ι) → (L i).PowerSegment (u i) (M₀ i)),\n        (∀ (n : ℕ), ∀ᶠ (i : ι) in ↑U, n < N₁ i) →\n          (∀ (n : ℕ), ∀ᶠ (i : ι) in ↑U, n < N₀ i) →\n            (∀ᶠ (i : ι) in ↑U, 2 * N₁ i ≤ M₁ i) →\n              (∀ᶠ (i : ι) in ↑U, 4 * N₀ i ≤ M₀ i) →\n                (∀ᶠ (i : ι) in ↑U, ∀ x ∈ B i, (L i).inv x ∈ B i) →\n                  (∀ᶠ (i : ι) in ↑U, ∀ n < N₁ i, (p i).power n ∈ B i) →\n                    (∀ᶠ (i : ι) in ↑U, ∀ n < N₀ i, (q i).power n ∈ B i) →\n                      ∀\n                        (π :\n                          DirectedCycles.LocalGroupHom (DirectedCycles.localUltraAlgebra (↑U) G L)\n                            (DirectedCycles.LocalGroupAlgebra.ofGroup H))\n                        (V : Set H),\n                        (∀ (x : H), (∀ (n : ℕ), x ^ n ∈ V) → x = 1) →\n                          (∀ z ∈ DirectedCycles.localUltraSet (↑U) G B, π.toFun z ∈ V) →\n                            ∀ (φ ψ : ℝ → H),\n                              (∀ (t : ℝ), |t| ≤ 1 → φ t = π.toFun (DirectedCycles.localScaledPower U G L g N₁ M₁ p t)) →\n                                (∀ (t : ℝ),\n                                    |t| ≤ 1 → ψ t = π.toFun (DirectedCycles.localScaledPower U G L u N₀ M₀ q t)) →\n                                  (∀ (s t : ℝ), ψ (s + t) = ψ s * ψ t) →\n                                    ∀ {r δ t t' : ℝ},\n                                      0 < r →\n                                        0 < δ →\n                                          ∀ (X : E),\n                                            ‖X‖ ≤ 1001 / 1000 * r →\n                                              (∀ (s : ℝ), φ s = DirectedCycles.lieExponential ((t * s) • X)) →\n                                                (∀ (s : ℝ), ψ s = DirectedCycles.lieExponential ((t' * s) • X)) →\n                                                  (∀ (z : DirectedCycles.LocalUltraproduct (↑U) G),\n                                                      π.toFun z ∈\n                                                          DirectedCycles.lieExponential '' Metric.ball 0 (δ * r) →\n                                                        z ∈ DirectedCycles.localUltraSet (↑U) G B) →\n                                                    ∀ (m : ι → ℤ) (s : (i : ι) → ℕ → G i),\n                                                      (∀ᶠ (i : ι) in ↑U, (m i).natAbs * N₁ i ≤ 2 * N₀ i) →\n                                                        (∀ᶠ (i : ι) in ↑U,\n                                                            ∀ n ≤ N₁ i,\n                                                              (L i).mulRel ((p i).power n)\n                                                                ((q i).signedPower (-m i * ↑n)) (s i n)) →\n                                                          (∀ᶠ (i : ι) in ↑U, ∀ n ≤ N₁ i, ⋯) →\n                                                            ∀ᶠ (i : ι) in ↑U, ∀ n ≤ N₁ i, s i n ∈ B i"}
