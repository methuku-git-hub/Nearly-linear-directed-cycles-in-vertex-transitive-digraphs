ype":"∀ {G : Type u_1} {V : Type u_2} [inst : Group G] [Fintype G] [inst_2 : Fintype V] [DecidableEq V]\n  [inst_4 : MulAction G V] (H : Subgroup G) [H.Normal] [Fintype (Quotient (MulAction.orbitRel (↥H) V))]\n  [inst_7 : DecidableEq (Quotient (MulAction.orbitRel (↥H) V))] (D : DirectedCycles.Digraph V),\n  (∀ (g : G) (x y : V), D (g • x) (g • y) ↔ D x y) →\n    (∀ (x y : V), ∃ g, g • x = y) →\n      ∀ (m : ℕ),\n        2 ≤ m →\n          ∀ (ρ : ℝ),\n            1 ≤ ρ →\n              (∀ (a : Quotient (MulAction.orbitRel (↥H) V)), {x | Quotient.mk'' x = a}.card = m) →\n                (∀ (x y : V), (MulAction.orbitRel (↥H) V) x y → ∃ P, ↑P.length ≤ ρ) →\n                  ∀ (x : V),\n                    have u := ⌈4 * ρ * Real.log (2 * ↑(Fintype.card V))⌉₊;\n                    ∃ a, m < 2 * {y ∈ DirectedCycles.forwardBall D u x | Quotient.mk'' y = a}.card"}
