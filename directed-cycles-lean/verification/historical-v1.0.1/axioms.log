) →\n                      (∀ (i : ι), ∀ n < Ku i, (qu i).power n ∈ B i) →\n                        (∀ (i : ι), ∀ n < Kg i, (qg i).power n ∈ B i) →\n                          (∀ (i : ι), (pu i).power (Nu i) ∉ A i) →\n                            (∀ (i : ι), (pg i).power (Ng i) ∉ A i) →\n                              (∀ (i : ι), (qu i).power (Ku i) ∉ B i) →\n                                (∀ (i : ι), (qg i).power (Kg i) ∉ B i) →\n                                  (∀ (i : ι), ∀ n ≤ 4 * Ku i, (qu i).power n ∈ (L i).wordPower (↑(B i)) 8) →\n                                    (∀ (i : ι), ∀ n ≤ 4 * Kg i, (qg i).power n ∈ (L i).wordPower (↑(B i)) 8) →\n                                      (∀ (i : ι), u i ∈ B i) →\n                                        ∀ (hg : ∀ (i : ι), g i ∈ B i),\n                                          (∀ (i : ι), 1 / ↑(Nu i) ≤ 1 / ↑(Ng i)) →\n                                            (∀ (n : ℕ), ∀ᶠ (i : ι) in ↑U, n < Nu i) →\n                                              (∀ (n : ℕ), ∀ᶠ (i : ι) in ↑U, n < Kg i) →\n                                                ∀\n                                                  (π :\n                                                    DirectedCycles.LocalGroupHom\n                                                      (DirectedCycles.localUltraAlgebra (↑U) G L)\n                                                      (DirectedCycles.LocalGroupAlgebra.ofGroup H))\n                                                  (V : Set H),\n                                                  IsCompact V →\n                                                    (∀ (x : H), (∀ (n : ℕ), x ^ n ∈ V) → x = 1) →\n                                                      (∀ z ∈ DirectedCycles.localUltraSet (↑U) G fun i => ↑(A i),\n                                                          π.toFun z ∈ V) →\n                                                        ∀ {R r δ : ℝ}, 0 < r → ⋯"}
