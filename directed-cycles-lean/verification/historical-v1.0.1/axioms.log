 N₁ M₁ p t)) →\n                                (∀ (t : ℝ),\n                                    |t| ≤ 1 → ψ t = π.toFun (DirectedCycles.localScaledPower U G L u N₀ M₀ q t)) →\n                                  (∀ (s t : ℝ), ψ (s + t) = ψ s * ψ t) →\n                                    ∀ {r δ t t' : ℝ},\n                                      0 < r →\n                                        0 < δ →\n                                          ∀ (X : E),\n                                            ‖X‖ ≤ 1001 / 1000 * r →\n                                              (∀ (s : ℝ), φ s = DirectedCycles.lieExponential ((t * s) • X)) →\n                                                (∀ (s : ℝ), ψ s = DirectedCycles.lieExponential ((t' * s) • X)) →\n                                                  |t| ≤ 11 / 10 * δ →\n                                                    9 / 10 * δ ≤ t' →\n                                                      t' ≤ 11 / 10 * δ →\n                                                        (∀ᶠ (i : ι) in ↑U, ↑(N₁ i) ≤ 11 / 10 * ↑(N₀ i)) →\n                                                          (∀ (z : DirectedCycles.LocalUltraproduct (↑U) G),\n                                                              π.toFun z ∈\n                                                                  DirectedCycles.lieExponential ''\n                                                                    Metric.ball 0 (δ * r) →\n                                                                z ∈\n                                                                  DirectedCycles.localUltraSet (↑U) G fun i => ↑(B i)) →\n                                                            (∀ (i : ι), 0 < N₀ i) →\n                                                              (∀ (i : ι), 0 < N₁ i) →\n                                                                ∀ (C P : (i : ι) → Set (G i))\n                                                                  (D : (i : ι) → (L i).CentralQuotientData (P i)), ⋯"}
