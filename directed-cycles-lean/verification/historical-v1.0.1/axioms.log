l_quotient_window","type":"∀ {G : Type u_1} [inst : Group G] {A : Set G},\n  1 ∈ A →\n    A⁻¹ = A →\n      ∀ (C : ℕ),\n        (∀ (x : G), (∀ (j : ℕ), 1 ≤ j → j ≤ C → x ^ j ∈ A ^ 2) → x ∈ A) →\n          ∀ {B D : ℝ},\n            0 < B →\n              0 ≤ D →\n                (∀ (l : List G),\n                    DirectedCycles.escapeNorm A l.prod ≤ B * (List.map (DirectedCycles.escapeNorm A) l).sum) →\n                  ∀ {u : G},\n                    0 < DirectedCycles.escapeNorm A u →\n                      (∀ v ∈ A, v ≠ 1 → DirectedCycles.escapeNorm A u ≤ DirectedCycles.escapeNorm A v) →\n                        (∀ x ∈ A,\n                            DirectedCycles.escapeNorm A (x⁻¹ * u⁻¹ * x * u) ≤\n                              D * DirectedCycles.escapeNorm A x * DirectedCycles.escapeNorm A u) →\n                          ∀ {N : ℕ},\n                            0 < N →\n                              u ^ N ∉ A →\n                                (∀ i < N, u ^ i ∈ A) →\n                                  have δ := DirectedCycles.centralQuotientRadius C B D;\n                                  0 < δ ∧\n                                    δ ≤ 1 / 2 ∧\n                                      (∀ x ∈ DirectedCycles.escapeSublevel A δ, Commute x u) ∧\n                                        ∃ V,\n                                          DirectedCycles.LocalNormalSet (DirectedCycles.shortPowerProgression u N) V ∧\n                                            DirectedCycles.escapeSublevel A δ ^ 6 ⊆ V"}
