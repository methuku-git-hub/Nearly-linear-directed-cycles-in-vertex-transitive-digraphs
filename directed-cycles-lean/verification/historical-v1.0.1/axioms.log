→\n      (Function.Injective fun i =>\n          (QuotientGroup.mk' (DirectedCycles.elementClosure a)) (DirectedCycles.cycleLabelPrefixes data i.castSucc)) →\n        (∀ (i : Fin data.length),\n            D ≤ data[↑i].1 ∧\n              data[↑i].1 + 2 * D + 2 ≤\n                Nat.card\n                  (↥(DirectedCycles.elementClosure a) ⧸\n                    (DirectedCycles.elementCommutators a).subgroupOf (DirectedCycles.elementClosure a))) →\n          ∀ (S : Set G),\n            a ∈ S →\n              (∀ (i : Fin data.length), data[↑i].2 ∈ S) →\n                ∀ (Q : DirectedCycles.Cycle (DirectedCycles.cyclicAuxiliaryGraph a D data hne)),\n                  ∃ C,\n                    Q.length ≤ C.length ∧\n                      C.ClosedUnderGenerator a ∧\n                        (DirectedCycles.SpansTruncation D\n                            (Set.range fun i =>\n                              (QuotientGroup.mk' (DirectedCycles.elementClosure a))\n                                (DirectedCycles.cycleLabelPrefixes data i.castSucc)) →\n                          (∀ (z : ZMod (DirectedCycles.slotBaseline (DirectedCycles.cyclicLiftSlots a D data)).length),\n                              DirectedCycles.SpansTruncation D\n                                (DirectedCycles.auxiliaryLayerCoordinates a D data hne Q z)) →\n                            DirectedCycles.SpansTruncation D (C.generatorTails a))"}
