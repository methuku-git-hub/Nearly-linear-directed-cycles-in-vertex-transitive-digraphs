s) (ψ t) (ψ (s + t))) →\n                                    ∀ {r δ t t' : ℝ},\n                                      0 < r →\n                                        0 < δ →\n                                          ∀ (X : E),\n                                            ‖X‖ ≤ 1001 / 1000 * r →\n                                              (∀ (s : ℝ), |s| ≤ 1 → φ s = ↑Y.chart ((t * s) • X)) →\n                                                (∀ (s : ℝ), |s| ≤ 2 → ψ s = ↑Y.chart ((t' * s) • X)) →\n                                                  (|t| + 2 * |t'|) * ‖X‖ < Y.radius →\n                                                    |t| ≤ 11 / 10 * δ →\n                                                      9 / 10 * δ ≤ t' →\n                                                        t' ≤ 11 / 10 * δ →\n                                                          (∀ᶠ (i : ι) in ↑U, ↑(N₁ i) ≤ 11 / 10 * ↑(N₀ i)) →\n                                                            (∀ (z : DirectedCycles.LocalUltraproduct (↑U) G),\n                                                                π.toFun z ∈ ↑Y.chart '' Metric.ball 0 (δ * r) →\n                                                                  z ∈\n                                                                    DirectedCycles.localUltraSet (↑U) G fun i =>\n                                                                      ↑(B i)) →\n                                                              (∀ (i : ι), 0 < N₀ i) →\n                                                                (∀ (i : ι), 0 < N₁ i) →\n                                                                  ∀ (C P : (i : ι) → Set (G i))\n                                                                    (D : (i : ι) → (L i).CentralQuotientData (P i)), ⋯"}
