module

public import DirectedCycles.TreePotentials

@[expose] public section

set_option autoImplicit false
namespace DirectedCycles

/-- The voltage from each vertex to the root, computed along the inward
branching, obeys the exact edge equation used in the collision argument. -/
theorem inward_tree_voltages {G I : Type*} [Group G] [Fintype I]
    {D : Digraph I} {root : I}
    (A : PartialOutBranching (fun x y => D y x) root Finset.univ)
    (label : I → I → G) :
    ∃ t : I → G, t root = 1 ∧
      ∀ x y, A.arc y x → t x = label x y * t y := by
  let p := fun i => A.potential (fun x y => (label y x)⁻¹) i (Finset.mem_univ i)
  refine ⟨fun i => (p i)⁻¹,?_,?_⟩
  · have hh := A.potential_root (fun x y => (label y x)⁻¹)
    change p root = 1 at hh
    change (p root)⁻¹ = 1
    rw [hh,inv_one]
  · intro x y hxy
    have he := A.potential_arc (fun x y => (label y x)⁻¹)
      (Finset.mem_univ y) (Finset.mem_univ x) hxy
    change p x = p y * (label x y)⁻¹ at he
    change (p x)⁻¹ = label x y * (p y)⁻¹
    rw [he,mul_inv_rev,inv_inv]

theorem PartialOutBranching.incoming {I : Type*} {D : Digraph I} {root : I} {U : Finset I}
    (B : PartialOutBranching D root U) {v : I} (hv : v ∈ U) (hne : v ≠ root) :
    ∃ x, B.arc x v := by
  have h := B.reachable v hv
  cases h with
  | refl => exact (hne rfl).elim
  | tail _ hxy => exact ⟨_,hxy⟩

/-- Every coordinate of a strongly connected voltage graph is generated by
its arc labels. This includes loops and all parallel labelled arcs. -/
theorem voltage_labels_generate {G I : Type*} [Group G] (S : I → I → Set G)
    (root : I) (hsc : StronglyConnected (VoltageDigraph S)) (H : Subgroup G)
    (hlabels : ∀ i j s, s ∈ S i j → s ∈ H) : H = ⊤ := by
  apply top_unique
  intro g _
  have hh : ∀ {z : G × I}, Reachable (VoltageDigraph S) (1,root) z → z.1 ∈ H := by
    intro z hz
    induction hz with
    | refl => exact H.one_mem
    | @tail y z hr hyz ih =>
      obtain ⟨s,hs,he⟩ := hyz
      rw [he]
      exact H.mul_mem ih (hlabels y.2 z.2 s hs)
  exact hh (hsc (1,root) (g,root))

/-- Once outward-tree labels are 1, the products of all prescribed return
walks generate the entire group. The family retains within-orbit arcs. -/
theorem return_products_generate {G I : Type*} [Group G] [Fintype I]
    {D : Digraph I} {root : I} (B : PartialOutBranching D root Finset.univ)
    (S : I → I → Set G) (t : I → G) (ht : t root = 1)
    (hout : ∀ x y, B.arc x y → 1 ∈ S x y)
    (hsc : StronglyConnected (VoltageDigraph S)) :
    Subgroup.closure {g : G | ∃ i j s, s ∈ S i j ∧ g = s * t j} = ⊤ := by
  let H := Subgroup.closure {g : G | ∃ i j s, s ∈ S i j ∧ g = s * t j}
  have hprod : ∀ i j s, s ∈ S i j → s * t j ∈ H := by
    intro i j s hs
    exact Subgroup.subset_closure ⟨i,j,s,hs,rfl⟩
  have htin : ∀ i, t i ∈ H := by
    intro i
    by_cases hi : i = root
    · rw [hi,ht]
      exact H.one_mem
    · obtain ⟨x,hx⟩ := B.incoming (Finset.mem_univ i) hi
      simpa only [one_mul] using hprod x i 1 (hout x i hx)
  apply voltage_labels_generate S root hsc H
  intro i j s hs
  have hh := H.mul_mem (hprod i j s hs) (H.inv_mem (htin j))
  simpa only [mul_inv_cancel_right] using hh

end DirectedCycles
