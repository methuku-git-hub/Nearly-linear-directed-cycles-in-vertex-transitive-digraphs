module

public import DirectedCycles.NormalizedCoordinateSystem

@[expose] public section

set_option autoImplicit false
namespace DirectedCycles

/-- A retained position has a specified baseline and its available word labels. -/
structure LayerSlot (G : Type*) [Group G] where
  baseline : G
  labels : Set G
  baseline_mem : baseline ∈ labels

def slotBaseline {G : Type*} [Group G] (slots : List (LayerSlot G)) : List G :=
  slots.map LayerSlot.baseline

@[simp] theorem slotBaseline_length {G : Type*} [Group G] (slots : List (LayerSlot G)) :
    (slotBaseline slots).length = slots.length := by simp [slotBaseline]

def slotLabels {G : Type*} [Group G] (slots : List (LayerSlot G))
    [NeZero (slotBaseline slots).length] (i : ZMod (slotBaseline slots).length) : Set G :=
  (slots[i.val]'(by simpa only [slotBaseline_length] using ZMod.val_lt i)).labels

/-- The recorded slot baselines form an actual allowed word. -/
theorem slotBaseline_allowed {G : Type*} [Group G] (slots : List (LayerSlot G))
    [NeZero (slotBaseline slots).length] : LayerWord (slotLabels slots) 0 (slotBaseline slots) := by
  apply (layerWord_iff_get _ _ _).mpr
  intro j
  have hj : j.val < slots.length := by simpa only [slotBaseline_length] using j.isLt
  have hval : ((0+j.val : ZMod (slotBaseline slots).length)).val = j.val := by
    simp only [zero_add,ZMod.val_natCast_of_lt j.isLt]
  change (slotBaseline slots)[j.val] ∈ (slots[(0+j.val : ZMod (slotBaseline slots).length).val]).labels
  have hidx : (⟨(0+j.val : ZMod (slotBaseline slots).length).val,by
      simpa only [slotBaseline_length] using ZMod.val_lt (0+j.val : ZMod (slotBaseline slots).length)⟩ : Fin slots.length) =
      ⟨j.val,hj⟩ := Fin.ext hval
  have hslot := congrArg (fun k : Fin slots.length => slots[k.val]) hidx
  rw [hslot]
  simp only [slotBaseline,List.getElem_map]
  exact (slots[j.val]).baseline_mem

/-- Normalizing the recorded slots always produces a strongly connected graph
on the actual group generated by its round products. -/
theorem slotCoordinate_stronglyConnected {G : Type*} [Group G] [Finite G]
    (slots : List (LayerSlot G)) [NeZero (slotBaseline slots).length] :
    StronglyConnected (CyclicLayerDigraph
      (restrictedLayerLabels (normalizedLabelSet (slotBaseline slots) (slotLabels slots))
        (Subgroup.closure (layerRoundProducts (normalizedLabelSet (slotBaseline slots) (slotLabels slots)))))) :=
  normalizedCoordinate_stronglyConnected _ _ (slotBaseline_allowed slots)

/-- The actual coordinate group is contained in the normal fibre when every
slot has the same quotient label as its baseline and the baseline closes. -/
theorem slotCoordinate_group_le {G : Type*} [Group G] (N : Subgroup G) [N.Normal]
    (slots : List (LayerSlot G)) [NeZero (slotBaseline slots).length]
    (hprod : (slotBaseline slots).prod ∈ N)
    (hslots : ∀ z ∈ slots, ∀ a ∈ z.labels, QuotientGroup.mk' N a = QuotientGroup.mk' N z.baseline) :
    Subgroup.closure (layerRoundProducts (normalizedLabelSet (slotBaseline slots) (slotLabels slots))) ≤ N := by
  apply normalizedCoordinate_group_le N _ _ hprod
  intro i a ha
  have hi : i.val < slots.length := by simpa only [slotBaseline_length] using ZMod.val_lt i
  have h := hslots slots[i.val] (List.getElem_mem _) a ha
  simpa only [coordinateIndex,slotBaseline,List.getElem_map] using h

end DirectedCycles
