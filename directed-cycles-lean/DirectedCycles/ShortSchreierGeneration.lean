module

public import DirectedCycles.FiniteNormalProducts

@[expose] public section

set_option autoImplicit false
open scoped Pointwise
namespace DirectedCycles

/-- A finite-index normal subgroup is generated by short words in the
ambient symmetric generating set. The proof keeps the actual coset
representatives, so the radius bound is explicit. -/
theorem short_normal_subgroup_generation {G : Type*} [Group G] [Finite G]
    (S : Set G) (h1 : 1 ∈ S) (hi : S⁻¹ = S) (hgen : Subgroup.closure S = ⊤)
    (N : Subgroup G) [N.Normal] :
    Subgroup.closure (S^(2*N.index+1) ∩ (N : Set G)) = N := by
  classical
  choose t htp htq using finite_short_coset_representatives S h1 hgen N
  let π : G →* G ⧸ N := QuotientGroup.mk' N
  have ht : ∀ q : G ⧸ N, t q ∈ S^N.index := fun q =>
    Set.pow_subset_pow_right h1 (Nat.sub_le N.index 1) (htp q)
  have hti : ∀ q : G ⧸ N, (t q)⁻¹ ∈ S^N.index := by
    intro q
    have hh := Set.inv_mem_inv.mpr (ht q)
    rwa [← inv_pow,hi] at hh
  have htπ : ∀ q : G ⧸ N, π (t q) = q := htq
  let B := Subgroup.closure (S^(2*N.index+1) ∩ (N : Set G))
  have hrem : ∀ g : G, (t (π g))⁻¹*g ∈ B := by
    intro g
    obtain ⟨n,hn⟩ := exists_mem_set_pow S hgen g
    induction n generalizing g with
    | zero =>
      have hg : g = 1 := hn
      subst g
      apply Subgroup.subset_closure
      constructor
      · simpa only [mul_one] using Set.pow_subset_pow_right h1 (by omega : N.index ≤ 2*N.index+1) (hti (π 1))
      · apply (QuotientGroup.eq_one_iff _).mp
        change π ((t (π 1))⁻¹*1) = 1
        rw [map_mul,map_inv,htπ,map_one,inv_one,mul_one]
    | succ n ih =>
      rw [pow_succ'] at hn
      obtain ⟨s,hs,a,ha,rfl⟩ := hn
      have haB := ih a ha
      have hsN : (t (π (s*a)))⁻¹*s*t (π a) ∈ N := by
        apply (QuotientGroup.eq_one_iff _).mp
        change π ((t (π (s*a)))⁻¹*s*t (π a)) = 1
        rw [map_mul,map_mul,map_inv,htπ,htπ,map_mul]
        group
      have hsS : (t (π (s*a)))⁻¹*s*t (π a) ∈ S^(2*N.index+1) := by
        have hh := Set.mul_mem_mul (Set.mul_mem_mul (hti (π (s*a)))
          (show s ∈ S^1 by simpa only [pow_one] using hs)) (ht (π a))
        rw [← pow_add,← pow_add] at hh
        convert hh using 1
        congr 1
        omega
      have hh := B.mul_mem (Subgroup.subset_closure ⟨hsS,hsN⟩) haB
      convert hh using 1
      group
  apply le_antisymm
  · exact N.closure_le.mpr Set.inter_subset_right
  · intro g hg
    have hπg : π g = 1 := (QuotientGroup.eq_one_iff g).mpr hg
    have hbase : t (1 : G ⧸ N) ∈ B := by
      apply Subgroup.subset_closure
      refine ⟨Set.pow_subset_pow_right h1 (by omega : N.index ≤ 2*N.index+1) (ht 1),?_⟩
      exact (QuotientGroup.eq_one_iff _).mp (htπ 1)
    have hh := hrem g
    rw [hπg] at hh
    simpa only [mul_inv_cancel_left] using B.mul_mem hbase hh

end DirectedCycles
