import DirectedCycles.CommutatorWeights
import DirectedCycles.NilpotentGeneration
import DirectedCycles.RelativeCentralSeries
import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

set_option autoImplicit false
open scoped commutatorElement Classical
namespace DirectedCycles

/-- The subgroup denoted [G,a] in the manuscript. -/
def elementCommutators {G : Type*} [Group G] (a : G) : Subgroup G :=
  Subgroup.closure (Set.range (fun g : G => ⁅g,a⁆))

/-- The subgroup generated by a and [G,a]. -/
def elementClosure {G : Type*} [Group G] (a : G) : Subgroup G :=
  Subgroup.zpowers a ⊔ elementCommutators a

theorem mem_elementCommutators {G : Type*} [Group G] (a g : G) :
    ⁅g,a⁆ ∈ elementCommutators a := Subgroup.subset_closure ⟨g,rfl⟩

theorem mem_elementClosure {G : Type*} [Group G] (a : G) : a ∈ elementClosure a :=
  (show Subgroup.zpowers a ≤ elementClosure a from le_sup_left) (Subgroup.mem_zpowers a)

theorem elementCommutators_le_derived {G : Type*} [Group G] (a : G) :
    elementCommutators a ≤ commutator G := by
  apply (commutator G).closure_le.mpr
  rintro _ ⟨g,rfl⟩
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top g) (Subgroup.mem_top a)

/-- The elementary conjugation identity proving normality of [G,a]. -/
theorem conjugate_element_commutator {G : Type*} [Group G] (a g x : G) :
    x * ⁅g,a⁆ * x⁻¹ = ⁅x*g,a⁆ * ⁅x,a⁆⁻¹ := by
  simp only [commutatorElement_def]
  group

instance elementCommutators_normal {G : Type*} [Group G] (a : G) :
    (elementCommutators a).Normal := by
  refine ⟨fun b hb x => ?_⟩
  have hle : elementCommutators a ≤ (elementCommutators a).comap (MulAut.conj x).toMonoidHom := by
    apply ((elementCommutators a).comap (MulAut.conj x).toMonoidHom).closure_le.mpr
    rintro _ ⟨g,rfl⟩
    change x * ⁅g,a⁆ * x⁻¹ ∈ elementCommutators a
    rw [conjugate_element_commutator]
    exact (elementCommutators a).mul_mem (mem_elementCommutators a (x*g))
      ((elementCommutators a).inv_mem (mem_elementCommutators a x))
  exact hle hb

instance elementClosure_normal {G : Type*} [Group G] (a : G) :
    (elementClosure a).Normal := by
  refine ⟨fun k hk x => ?_⟩
  have hmap : (elementClosure a).map (MulAut.conj x).toMonoidHom ≤ elementClosure a := by
    rw [elementClosure, Subgroup.map_sup, MonoidHom.map_zpowers]
    apply sup_le
    · apply Subgroup.zpowers_le.mpr
      change x*a*x⁻¹ ∈ Subgroup.zpowers a ⊔ elementCommutators a
      rw [show x*a*x⁻¹ = ⁅x,a⁆*a by simp [commutatorElement_def, mul_assoc]]
      exact (Subgroup.zpowers a ⊔ elementCommutators a).mul_mem
        ((show elementCommutators a ≤ Subgroup.zpowers a ⊔ elementCommutators a from le_sup_right) (mem_elementCommutators a x))
        ((show Subgroup.zpowers a ≤ Subgroup.zpowers a ⊔ elementCommutators a from le_sup_left) (Subgroup.mem_zpowers a))
    · intro y hy
      obtain ⟨b,hb,rfl⟩ := hy
      exact (show elementCommutators a ≤ Subgroup.zpowers a ⊔ elementCommutators a from le_sup_right)
        ((inferInstance : (elementCommutators a).Normal).conj_mem b hb x)
  exact hmap (Subgroup.mem_map_of_mem _ hk)

/-- The displayed subgroup is exactly the normal closure of the element. -/
theorem elementClosure_eq_normalClosure {G : Type*} [Group G] (a : G) :
    elementClosure a = Subgroup.normalClosure ({a} : Set G) := by
  apply le_antisymm
  · apply sup_le
    · exact Subgroup.zpowers_le.mpr (Subgroup.subset_normalClosure (Set.mem_singleton a))
    · apply (Subgroup.normalClosure ({a} : Set G)).closure_le.mpr
      rintro _ ⟨g,rfl⟩
      exact Subgroup.commutator_le_right (⊤ : Subgroup G) (Subgroup.normalClosure {a})
        (Subgroup.commutator_mem_commutator (Subgroup.mem_top g)
          (Subgroup.subset_normalClosure (Set.mem_singleton a)))
  · exact Subgroup.normalClosure_le_normal (Set.singleton_subset_iff.mpr (mem_elementClosure a))

theorem elementClosure_image {G : Type*} [Group G] (a : G) :
    (elementClosure a).map (QuotientGroup.mk' (elementCommutators a)) =
      Subgroup.zpowers (QuotientGroup.mk' (elementCommutators a) a) := by
  rw [elementClosure, Subgroup.map_sup, MonoidHom.map_zpowers]
  have h : (elementCommutators a).map (QuotientGroup.mk' (elementCommutators a)) = ⊥ := by
    rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
  rw [h, sup_bot_eq]

theorem element_mod_commutators_central {G : Type*} [Group G] (a : G) :
    QuotientGroup.mk' (elementCommutators a) a ∈ Subgroup.center (G ⧸ elementCommutators a) := by
  let q := QuotientGroup.mk' (elementCommutators a)
  apply Subgroup.mem_center_iff.mpr
  intro y
  obtain ⟨g,rfl⟩ := QuotientGroup.mk'_surjective (elementCommutators a) y
  apply commutatorElement_eq_one_iff_mul_comm.mp
  rw [← map_commutatorElement q]
  exact (QuotientGroup.eq_one_iff _).mpr (mem_elementCommutators a g)

/-- Commuting with the whole normal closure adds no generators to [G,a]. -/
theorem commutator_elementClosure {G : Type*} [Group G] (a : G) :
    ⁅(⊤ : Subgroup G), elementClosure a⁆ = elementCommutators a := by
  apply le_antisymm
  · let q := QuotientGroup.mk' (elementCommutators a)
    have hc : (elementClosure a).map q ≤ Subgroup.center (G ⧸ elementCommutators a) := by
      rw [elementClosure_image]
      exact Subgroup.zpowers_le.mpr (element_mod_commutators_central a)
    have h := Subgroup.commutator_top_left_eq_bot_iff_le_center.mpr hc
    rw [← Subgroup.map_top_of_surjective q (QuotientGroup.mk'_surjective _),
      ← Subgroup.map_commutator, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at h
    exact h
  · apply (⁅(⊤ : Subgroup G),elementClosure a⁆).closure_le.mpr
    rintro _ ⟨g,rfl⟩
    exact Subgroup.commutator_mem_commutator (Subgroup.mem_top g) (mem_elementClosure a)

instance elementClosure_factor_isCyclic {G : Type*} [Group G] (a : G) :
    IsCyclic (elementClosure a ⧸ (elementCommutators a).subgroupOf (elementClosure a)) := by
  let E := subgroupQuotientEquivMap (elementClosure a) (elementCommutators a)
  have h : IsCyclic ((elementClosure a).map (QuotientGroup.mk' (elementCommutators a))) :=
    (Subgroup.isCyclic_iff_exists_zpowers_eq_top _).mpr
      ⟨_, (elementClosure_image a).symm⟩
  exact E.symm.isCyclic.mp h

/-- If one normal closure is all of a finite nilpotent group, that element
already generates the group as a cyclic subgroup. -/
theorem elementClosure_eq_top_implies_cyclic {G : Type*} [Group G] [Finite G]
    [Group.IsNilpotent G] (a : G) (ha : elementClosure a = ⊤) : Subgroup.zpowers a = ⊤ := by
  apply nilpotent_commutator_nongenerating
  apply top_le_iff.mp
  rw [← ha]
  exact sup_le_sup_left (elementCommutators_le_derived a) _

/-- An explicit uniform exponent for the order bound in Lemma 5.2. -/
theorem elementClosure_order_bound {G : Type*} [Group G] [Finite G] [Group.IsNilpotent G]
    (a : G) (r c : ℕ) (hr : Group.rank G ≤ r) (hc : Group.nilpotencyClass G ≤ c) :
    Nat.card (elementClosure a) ≤
      Nat.card (elementClosure a ⧸ (elementCommutators a).subgroupOf (elementClosure a)) ^
        (c * ∑ i ∈ Finset.range c, r ^ (i+1)) := by
  apply normal_subgroup_order_of_relative_exponent (elementClosure a) r c _ hr hc Nat.card_pos
  intro x
  change x.val ^ _ ∈ ⁅elementClosure a,(⊤ : Subgroup G)⁆
  rw [Subgroup.commutator_comm, commutator_elementClosure]
  let q := QuotientGroup.mk' ((elementCommutators a).subgroupOf (elementClosure a))
  have h := pow_card_eq_one' (x := q x)
  rw [← map_pow] at h
  exact (QuotientGroup.eq_one_iff (x ^ Nat.card (elementClosure a ⧸ (elementCommutators a).subgroupOf (elementClosure a)))).mp h

/-- A nonidentity element has a nontrivial cyclic normal-closure quotient. -/
theorem elementClosure_factor_card_ge_two {G : Type*} [Group G] [Finite G]
    [Group.IsNilpotent G] (a : G) (ha : a ≠ 1) :
    2 ≤ Nat.card (elementClosure a ⧸ (elementCommutators a).subgroupOf (elementClosure a)) := by
  let h := Nat.card (elementClosure a ⧸ (elementCommutators a).subgroupOf (elementClosure a))
  have hp : 0 < h := Nat.card_pos
  by_contra hn
  have hh : h = 1 := by omega
  have hb := elementClosure_order_bound a (Group.rank G) (Group.nilpotencyClass G) le_rfl le_rfl
  change Nat.card (elementClosure a) ≤ h ^ _ at hb
  rw [hh, one_pow] at hb
  have hk : Nat.card (elementClosure a) = 1 := le_antisymm hb Nat.card_pos
  have hsub := (Nat.card_eq_one_iff_unique.mp hk).1
  have he : (⟨a,mem_elementClosure a⟩ : elementClosure a) = 1 := hsub.elim _ _
  exact ha (congrArg Subtype.val he)

/-- All substantive conclusions of manuscript Lemma 5.2, with the explicit
constant M(r,c)=c times the sum of the lower-factor rank bounds. -/
theorem normal_closure_of_one_element {G : Type*} [Group G] [Finite G] [Group.IsNilpotent G]
    (a : G) (ha : a ≠ 1) (r c : ℕ) (hr : Group.rank G ≤ r)
    (hc : Group.nilpotencyClass G ≤ c) :
    let B := elementCommutators a
    let K := elementClosure a
    let h := Nat.card (K ⧸ B.subgroupOf K)
    B.Normal ∧ K.Normal ∧ K = Subgroup.normalClosure ({a} : Set G) ∧
    ⁅(⊤ : Subgroup G),K⁆ = B ∧ IsCyclic (K ⧸ B.subgroupOf K) ∧
    2 ≤ h ∧ Group.nilpotencyClass B ≤ c/2 ∧
    Nat.card K ≤ h ^ (c * ∑ i ∈ Finset.range c, r ^ (i+1)) ∧
    (K = ⊤ → Subgroup.zpowers a = ⊤) := by
  exact ⟨inferInstance,inferInstance,elementClosure_eq_normalClosure a,commutator_elementClosure a,
    inferInstance,elementClosure_factor_card_ge_two a ha,
    commutator_subgroup_class_le_half (elementCommutators a) (elementCommutators_le_derived a) c hc,
    elementClosure_order_bound a r c hr hc,elementClosure_eq_top_implies_cyclic a⟩

end DirectedCycles
