module

public import DirectedCycles.ScaledUltraproductPowers
public import DirectedCycles.ScaledPowerBounds

@[expose] public section

set_option autoImplicit false
namespace DirectedCycles
variable {ι : Type*} (U : Ultrafilter ι) (G : ι → Type*) [∀ i, Group (G i)]

/-- Every real-scaled power belongs to the subgroup generated by the internal
approximate set. The model map therefore has the required domain; it need not
be extended to the full ambient ultraproduct. -/
theorem scaledUltraPower_mem_closure (A : ∀ i, Set (G i)) (u : ∀ i, G i) (N : ι → ℕ)
    (hN : ∀ᶠ i in (U : Filter ι), 2 ≤ N i)
    (hprev : ∀ᶠ i in (U : Filter ι), ∀ n < N i, (u i)^n ∈ A i) (t : ℝ) :
    scaledUltraPower U G u N t ∈ Subgroup.closure (ultraSet (U : Filter ι) G A) := by
  classical
  obtain ⟨M,hM⟩ := exists_nat_gt |t|
  let n := fun i => Int.floor (t*(N i : ℝ))
  let d := fun i => (N i : ℤ)-1
  let q := fun i => n i/d i
  let r := fun i => n i%d i
  let a : ∀ i, G i := fun i => (u i)^(d i)
  let b : ∀ i, G i := fun i => (u i)^(r i)
  have ha : ultraMk (U : Filter ι) G a ∈ ultraSet (U : Filter ι) G A := by
    apply (ultraMk_mem_ultraSet_iff _ G A a).2
    filter_upwards [hN,hprev] with i hNi hpi
    have he : d i = ((N i-1 : ℕ) : ℤ) := by dsimp [d]; omega
    change (u i)^(d i) ∈ A i
    rw [he,zpow_natCast]
    exact hpi (N i-1) (by omega)
  have hb : ultraMk (U : Filter ι) G b ∈ ultraSet (U : Filter ι) G A := by
    apply (ultraMk_mem_ultraSet_iff _ G A b).2
    filter_upwards [hN,hprev] with i hNi hpi
    have hd : 0 < d i := by dsimp [d]; omega
    have hr0 : 0 ≤ r i := Int.emod_nonneg (n i) (by omega : d i ≠ 0)
    have hrd : r i < d i := Int.emod_lt_of_pos (n i) hd
    have hrNat : ((r i).toNat : ℤ) = r i := Int.toNat_of_nonneg hr0
    have hnNat : (r i).toNat < N i := by dsimp [d] at hrd; omega
    change (u i)^(r i) ∈ A i
    rw [← hrNat,zpow_natCast]
    exact hpi _ hnNat
  have hq : ∀ᶠ i in (U : Filter ι), q i ∈ Finset.Icc (-(2*(M : ℤ))) (2*(M : ℤ)) := by
    filter_upwards [hN] with i hi
    exact Finset.mem_Icc.mpr (scaled_floor_div_bound t M (N i) hM.le hi)
  obtain ⟨m,_,hm⟩ := ultra_zpow_finite_choice U G a q _ hq
  have he : scaledUltraPower U G u N t =
      ultraMk (U : Filter ι) G (fun i => (a i)^(q i))*ultraMk (U : Filter ι) G b := by
    unfold scaledUltraPower
    rw [← map_mul]
    apply (ultraMk_eq_iff _ G _ _).2
    apply Filter.Eventually.of_forall
    intro i
    change (u i)^(n i) = ((u i)^(d i))^(q i)*(u i)^(r i)
    rw [← zpow_mul,← zpow_add]
    congr 1
    dsimp [q,r]
    nlinarith [Int.mul_ediv_add_emod (n i) (d i)]
  rw [he,hm]
  exact (Subgroup.closure (ultraSet (U : Filter ι) G A)).mul_mem
    ((Subgroup.closure (ultraSet (U : Filter ι) G A)).zpow_mem (Subgroup.subset_closure ha) m)
    (Subgroup.subset_closure hb)
end DirectedCycles
