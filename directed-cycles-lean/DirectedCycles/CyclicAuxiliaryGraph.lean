module

public import DirectedCycles.CyclicLiftSlots

@[expose] public section

set_option autoImplicit false
namespace DirectedCycles

theorem cyclicLiftSlots_baseline_length_pos {G : Type*} [Group G]
    (a : G) (D : ℕ) (data : List (ℕ × G)) (hne : data ≠ []) :
    0 < (slotBaseline (cyclicLiftSlots a D data)).length := by
  rw [slotBaseline_length,cyclicLiftSlots_length]
  cases data with
  | nil => exact (hne rfl).elim
  | cons z data => simp only [List.map_cons,List.sum_cons]; omega

/-- The actual normalized available labels for the retained positions. -/
def cyclicAuxiliaryLabels {G : Type*} [Group G]
    (a : G) (D : ℕ) (data : List (ℕ × G)) (hne : data ≠ []) :
    ZMod (slotBaseline (cyclicLiftSlots a D data)).length → Set G := by
  let : NeZero (slotBaseline (cyclicLiftSlots a D data)).length :=
    ⟨Nat.ne_of_gt (cyclicLiftSlots_baseline_length_pos a D data hne)⟩
  exact normalizedLabelSet (slotBaseline (cyclicLiftSlots a D data)) (slotLabels (cyclicLiftSlots a D data))

/-- The constructed auxiliary group, generated by all actual full-round products. -/
def cyclicAuxiliaryGroup {G : Type*} [Group G]
    (a : G) (D : ℕ) (data : List (ℕ × G)) (hne : data ≠ []) : Subgroup G :=
  Subgroup.closure (layerRoundProducts (cyclicAuxiliaryLabels a D data hne))

/-- The actual auxiliary digraph; its group and labels are definitions, not premises. -/
def cyclicAuxiliaryGraph {G : Type*} [Group G]
    (a : G) (D : ℕ) (data : List (ℕ × G)) (hne : data ≠ []) :
    Digraph (cyclicAuxiliaryGroup a D data hne × ZMod (slotBaseline (cyclicLiftSlots a D data)).length) :=
  CyclicLayerDigraph (restrictedLayerLabels (cyclicAuxiliaryLabels a D data hne)
    (cyclicAuxiliaryGroup a D data hne))

/-- Strong connectivity is proved for the constructed auxiliary graph. -/
theorem cyclicAuxiliaryGraph_stronglyConnected {G : Type*} [Group G] [Finite G]
    (a : G) (D : ℕ) (data : List (ℕ × G)) (hne : data ≠ []) :
    StronglyConnected (cyclicAuxiliaryGraph a D data hne) := by
  let : NeZero (slotBaseline (cyclicLiftSlots a D data)).length :=
    ⟨Nat.ne_of_gt (cyclicLiftSlots_baseline_length_pos a D data hne)⟩
  exact slotCoordinate_stronglyConnected (cyclicLiftSlots a D data)

/-- The constructed auxiliary group is contained in B under the exact baseline
closure condition. Every alternative connector has been checked modulo B. -/
theorem cyclicAuxiliaryGroup_le {G : Type*} [Group G]
    (a : G) (D : ℕ) (data : List (ℕ × G)) (hne : data ≠ [])
    (hclose : (QuotientGroup.mk' (elementCommutators a) a)^((data.map (fun z => z.1+D)).sum) *
        QuotientGroup.mk' (elementCommutators a) (data.map Prod.snd).prod = 1) :
    cyclicAuxiliaryGroup a D data hne ≤ elementCommutators a := by
  let : NeZero (slotBaseline (cyclicLiftSlots a D data)).length :=
    ⟨Nat.ne_of_gt (cyclicLiftSlots_baseline_length_pos a D data hne)⟩
  apply slotCoordinate_group_le (elementCommutators a)
  · rw [cyclicLiftSlots_baseline]
    exact cyclicBaselineWord_mem a D data hclose
  · exact cyclicLiftSlots_quotient a D data

end DirectedCycles
