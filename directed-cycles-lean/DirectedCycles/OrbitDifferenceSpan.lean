module

public import DirectedCycles.UnipotentRecurrence

@[expose] public section

set_option autoImplicit false
namespace DirectedCycles

/-- The L-invariant subgroup generated by adjacent cocycle differences. -/
def orbitDifferenceSpan {V : Type*} [AddCommGroup V]
    (L : V ≃ₗ[ℤ] V) {ell : ℕ} (v : Fin (ell+1) → V) : AddSubgroup V :=
  AddSubgroup.closure {w | ∃ i : Fin ell, ∃ k : ℤ, (L^k) (v i.castSucc-v i.succ) = w}

theorem orbitDifferenceSpan_generator {V : Type*} [AddCommGroup V]
    (L : V ≃ₗ[ℤ] V) {ell : ℕ} (v : Fin (ell+1) → V) (i : Fin ell) (k : ℤ) :
    (L^k) (v i.castSucc-v i.succ) ∈ orbitDifferenceSpan L v :=
  AddSubgroup.subset_closure ⟨i,k,rfl⟩

/-- Stability is proved for every integer iterate, in both directions. -/
theorem orbitDifferenceSpan_stable {V : Type*} [AddCommGroup V]
    (L : V ≃ₗ[ℤ] V) {ell : ℕ} (v : Fin (ell+1) → V) (k : ℤ) :
    ∀ x ∈ orbitDifferenceSpan L v, (L^k) x ∈ orbitDifferenceSpan L v := by
  intro x hx
  induction hx using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨i,j,rfl⟩ := hx
    rw [← LinearEquiv.mul_apply,← zpow_add]
    exact orbitDifferenceSpan_generator L v i (k+j)
  | zero => simpa only [map_zero] using (orbitDifferenceSpan L v).zero_mem
  | add x y _ _ hx hy =>
    rw [map_add]
    exact (orbitDifferenceSpan L v).add_mem hx hy
  | neg x _ hx =>
    rw [map_neg]
    exact (orbitDifferenceSpan L v).neg_mem hx

/-- Telescoping starts at the actual zero value. -/
theorem orbitDifferenceSpan_contains {V : Type*} [AddCommGroup V]
    (L : V ≃ₗ[ℤ] V) {ell : ℕ} (v : Fin (ell+1) → V) (h0 : v 0 = 0) :
    ∀ i, v i ∈ orbitDifferenceSpan L v := by
  intro i
  induction i using Fin.induction with
  | zero => rw [h0]; exact (orbitDifferenceSpan L v).zero_mem
  | succ i ih =>
    have hd := orbitDifferenceSpan_generator L v i 0
    change v i.castSucc-v i.succ ∈ orbitDifferenceSpan L v at hd
    have h := (orbitDifferenceSpan L v).sub_mem ih hd
    simpa only [sub_sub_cancel] using h

/-- The finitely supplied consecutive differences put the full invariant
span in C. This statement allows arbitrary integer shifts for each position. -/
theorem orbitDifferenceSpan_le {V : Type*} [AddCommGroup V]
    (L : V ≃ₗ[ℤ] V) {ell : ℕ} (v : Fin (ell+1) → V) (C : AddSubgroup V)
    (D : ℕ) (hnil : (L.toLinearMap-1)^D = 0) (shift : Fin ell → ℤ)
    (hC : ∀ i : Fin ell, ∀ j : ℕ, j < D →
      (L^(shift i+j)) (v i.castSucc-v i.succ) ∈ C) :
    orbitDifferenceSpan L v ≤ C := by
  apply C.closure_le.mpr
  rintro x ⟨i,k,rfl⟩
  exact unipotent_consecutive_orbit_mem L C D hnil _ (shift i) (hC i) k

end DirectedCycles
