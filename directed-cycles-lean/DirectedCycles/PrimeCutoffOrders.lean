import DirectedCycles.AbelianNormalClosure

set_option autoImplicit false
namespace DirectedCycles

/-- Under a prime cutoff, every nonidentity element has order above the cutoff. -/
theorem order_above_prime_cutoff {G : Type*} [Group G] [Finite G] (P : ℕ)
    (hp : ∀ p : ℕ, p.Prime → p ∣ Nat.card G → P < p) (x : G) (hx : x ≠ 1) :
    P < orderOf x := by
  have hn : orderOf x ≠ 1 := fun he => hx (orderOf_eq_one_iff.mp he)
  have hprime := Nat.minFac_prime hn
  have hdiv : (orderOf x).minFac ∣ Nat.card G := (Nat.minFac_dvd _).trans (orderOf_dvd_natCard x)
  exact (hp _ hprime hdiv).trans_le (Nat.minFac_le (isOfFinOrder_of_finite x).orderOf_pos)

/-- A nontrivial group generated by a set has a nonidentity member of that set. -/
theorem generating_set_nonidentity {G : Type*} [Group G] [Nontrivial G]
    (S : Set G) (hS : Subgroup.closure S = ⊤) : ∃ x ∈ S, x ≠ 1 := by
  by_contra he
  have hle : Subgroup.closure S ≤ (⊥ : Subgroup G) := by
    apply (⊥ : Subgroup G).closure_le.mpr
    intro x hx
    change x = 1
    by_contra hne
    exact he ⟨x,hx,hne⟩
  rw [hS] at hle
  exact top_ne_bot (le_bot_iff.mp hle)

end DirectedCycles
