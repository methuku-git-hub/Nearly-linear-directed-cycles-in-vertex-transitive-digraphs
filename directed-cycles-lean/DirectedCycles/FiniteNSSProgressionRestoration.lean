import DirectedCycles.FiniteNSSQuotient
import DirectedCycles.CosetProgressionQuotientLift
import DirectedCycles.CosetProgressionImage

set_option autoImplicit false
open scoped Pointwise
namespace DirectedCycles
variable {G : Type*} [Group G] [Fintype G]

/-- Removing the actual zero-escape subgroup produces an actual finite quotient
approximate group with no nontrivial cyclic subgroup inside it. The source is
precisely the subgroup generated by A. -/
theorem strong_finite_nss_quotient_with_kernel {K : ℕ} {A : Finset G}
    (hA : IsStrongFiniteApproximateGroup K A) :
    ∃ H : Subgroup (Subgroup.closure (A : Set G)), ∃ hH : H.Normal,
      letI := hH
      let U := Subgroup.closure (A : Set G)
      let B := U.subtype ⁻¹' (A : Set G)
      let q := QuotientGroup.mk' H
      (H : Set U) ⊆ B ∧ IsApproximateSubgroup (K : ℝ) (q '' B) ∧
        (∀ y : U ⧸ H, (∀ n : ℕ, y^n ∈ q '' B) → y = 1) := by
  classical
  obtain ⟨H₀,hzero,hsub,hnorm⟩ := strong_approximate_zero_subgroup hA
  let U := Subgroup.closure (A : Set G)
  let B := U.subtype ⁻¹' (A : Set G)
  have hAU : (A : Set G) ⊆ U := Subgroup.subset_closure
  have hUN : U ≤ Subgroup.normalizer (H₀ : Set G) := by
    apply (Subgroup.normalizer (H₀ : Set G)).closure_le.mpr
    exact (Set.subset_pow hA.approximate.one_mem (by omega : 10 ≠ 0)).trans hnorm
  let H := H₀.subgroupOf U
  have hH : H.Normal := Subgroup.normal_subgroupOf_of_le_normalizer hUN
  let : H.Normal := hH
  let q := QuotientGroup.mk' H
  have himage : U.subtype '' B = (A : Set G) := by
    rw [subtype_image_preimage, Set.inter_eq_left.mpr hAU]
  have hB : IsApproximateSubgroup (K : ℝ) B := by
    apply approximate_of_injective_image U.subtype U.subtype_injective
    rw [himage]
    exact hA.approximate
  have hker : (q.ker : Set U) ⊆ B := by
    intro x hx
    have hxH : x ∈ H := (QuotientGroup.eq_one_iff x).mp hx
    exact hsub hxH
  have hzero' : ∀ x : U, escapeNorm B x = 0 → x ∈ q.ker := by
    intro x hx
    have he : escapeNorm (A : Set G) x.val = 0 := by
      change escapeNorm (A : Set G) (U.subtype x) = 0
      rw [← escapeNorm_preimage U.subtype] 
      exact hx
    have hxH : x ∈ H := (hzero x.val).2 he
    exact (QuotientGroup.eq_one_iff x).2 hxH
  obtain ⟨S,hSi,hsmall,hfirst,hsecond⟩ := hA.trapping
  have htrap : ∀ x : U, (∀ j : ℕ, 1 ≤ j → j ≤ 1000 → x^j ∈ B^4) → x ∈ B := by
    intro x hx
    apply hfirst
    intro j hj hjC
    have him : U.subtype (x^j) ∈ U.subtype '' B^4 := ⟨x^j,hx j hj hjC,rfl⟩
    rw [Set.image_pow,himage] at him
    have hm : x.val^j ∈ (A : Set G)^4 := by simpa only [map_pow, Subgroup.coe_subtype] using him
    exact (Set.pow_subset_pow_right hA.approximate.one_mem (by omega : 4 ≤ 100)) hm
  refine ⟨H,hH,fun x hx => hsub hx,hB.image q,?_⟩
  exact quotient_no_small_subgroups q (QuotientGroup.mk'_surjective H)
    hB.one_mem hker hzero' 1000 (by omega) htrap

/-- The finite zero-escape reduction retains everything needed to restore
an actual quotient progression to the original group, with unchanged rank,
step and density factor and carrier in the original second power. -/
theorem strong_finite_nss_quotient_with_restoration {K : ℕ} {A : Finset G}
    (hA : IsStrongFiniteApproximateGroup K A) :
    ∃ H : Subgroup (Subgroup.closure (A : Set G)), ∃ hH : H.Normal,
      letI := hH
      let U := Subgroup.closure (A : Set G)
      let B := U.subtype ⁻¹' (A : Set G)
      let q := QuotientGroup.mk' H
      IsApproximateSubgroup (K : ℝ) (q '' B) ∧
      (∀ y : U ⧸ H, (∀ n : ℕ, y^n ∈ q '' B) → y = 1) ∧
      ∀ r c : ℕ, ∀ Q : CosetNilprogression (U ⧸ H) r c,
        Q.carrier ⊆ q '' B → ∀ J : ℕ, Nat.card (q '' B) ≤ J*Nat.card Q.carrier →
        ∃ P : CosetNilprogression G r c,
          P.carrier ⊆ (A : Set G)^2 ∧ Nat.card (A : Set G) ≤ J*Nat.card P.carrier := by
  classical
  obtain ⟨H,hH,hHB,hq,hNSS⟩ := strong_finite_nss_quotient_with_kernel hA
  let := hH
  let U := Subgroup.closure (A : Set G)
  let B := U.subtype ⁻¹' (A : Set G)
  let q := QuotientGroup.mk' H
  refine ⟨H,hH,hq,hNSS,?_⟩
  intro r c Q hQ J hcard
  have hKT : (H : Set U)*B ⊆ B^2 := by
    simpa only [pow_two] using Set.mul_subset_mul hHB (Set.Subset.refl B)
  obtain ⟨R,hR,hRcard⟩ := quotient_coset_progression_lift H B (B^2) hKT Q hQ J hcard
  obtain ⟨P,hP,hPcard⟩ := coset_progression_image_of_injective U.subtype U.subtype_injective
    R (B^2) hR (Nat.card B) J hRcard
  have hAU : (A : Set G) ⊆ U := Subgroup.subset_closure
  have himage : U.subtype '' B = (A : Set G) := by
    rw [subtype_image_preimage,Set.inter_eq_left.mpr hAU]
  have hBAcard : Nat.card B = Nat.card (A : Set G) := by
    rw [← Nat.card_image_of_injective U.subtype_injective,himage]
  rw [Set.image_pow,himage] at hP
  rw [hBAcard] at hPcard
  exact ⟨P,hP,hPcard⟩
end DirectedCycles
