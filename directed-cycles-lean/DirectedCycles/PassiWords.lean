module

public import DirectedCycles.AugmentationWords
public import DirectedCycles.PassiAugmentation

@[expose] public section

set_option autoImplicit false
open scoped BigOperators
namespace DirectedCycles

/-- The finite index type of all nonempty generator words shorter than D. -/
abbrev PositiveWordIndex (r D : ℕ) := Σ j : Fin (D-1), Fin (j.val+1) → Fin r

theorem positiveWordIndex_card (r D : ℕ) :
    Fintype.card (PositiveWordIndex r D) = ∑ j ∈ Finset.range (D-1), r^(j+1) := by
  simp only [PositiveWordIndex,Fintype.card_sigma,Fintype.card_fun,Fintype.card_fin]
  exact Fin.sum_univ_eq_sum_range (fun j : ℕ => r^(j+1)) (D-1)

theorem augmentationWord_mem_passi {G : Type*} [Group G] (D : ℕ) (hD : 0 < D)
    {ι : Type*} (u : ι → G) (xs : List ι) (hpos : 0 < xs.length) :
    augmentationWord D u xs ∈ passiGroup (G := G) D hD := by
  cases xs with
  | nil => simp at hpos
  | cons i xs =>
    change truncatedAugmentation D hD (augmentationWord D u (i::xs)) = 0
    rw [augmentationWord_cons,map_mul,map_sub,truncatedAugmentation_element,map_one,sub_self,zero_mul]

/-- The positive word span is exactly the Passi polynomial group. -/
theorem positiveWordSpan_eq_passi {G : Type*} [Group G] [Finite G]
    (D : ℕ) (hD : 0 < D) {ι : Type*} (u : ι → G)
    (hu : Subgroup.closure (Set.range u) = ⊤) :
    positiveWordSpan D u = passiGroup (G := G) D hD := by
  apply le_antisymm
  · apply (passiGroup D hD).closure_le.mpr
    rintro x ⟨xs,hpos,_,rfl⟩
    exact augmentationWord_mem_passi D hD u xs hpos
  · intro x hx
    let W := (positiveWordSpan D u).comap (passiGroup (G := G) D hD).subtype
    have hle : AddSubgroup.closure (Set.range (fun g =>
        passiProjection D hD 1 (truncatedElement G D g))) ≤ W := by
      apply W.closure_le.mpr
      rintro y ⟨g,rfl⟩
      change (passiProjection D hD 1 (truncatedElement G D g)).val ∈ positiveWordSpan D u
      rw [passiProjection_element,map_one]
      exact all_differences_mem_positiveWordSpan D hD u hu g
    rw [passiProjection_generates] at hle
    exact hle (show (⟨x,hx⟩ : passiGroup D hD) ∈ ⊤ from trivial)

noncomputable def passiWordGenerator {G : Type*} [Group G] (D : ℕ) (hD : 0 < D)
    {r : ℕ} (u : Fin r → G) (a : PositiveWordIndex r D) : passiGroup (G := G) D hD :=
  ⟨augmentationWord D u (List.ofFn a.2),
    augmentationWord_mem_passi D hD u _ (by simp)⟩

/-- The Passi group is generated by the advertised finite family of at most
sum_{j=1}^{D-1} r^j positive words. -/
theorem passiWordGenerator_generates {G : Type*} [Group G] [Finite G]
    (D : ℕ) (hD : 0 < D) {r : ℕ} (u : Fin r → G)
    (hu : Subgroup.closure (Set.range u) = ⊤) :
    AddSubgroup.closure (Set.range (passiWordGenerator D hD u)) = ⊤ := by
  let P := passiGroup (G := G) D hD
  let W := AddSubgroup.closure (Set.range (passiWordGenerator D hD u))
  have hle : positiveWordSpan D u ≤ W.map P.subtype := by
    apply (W.map P.subtype).closure_le.mpr
    rintro x ⟨xs,hpos,hlt,rfl⟩
    have hlen : xs.length-1+1 = xs.length := Nat.sub_add_cancel (by omega)
    let a : PositiveWordIndex r D :=
      ⟨⟨xs.length-1,by omega⟩,fun i => xs.get (Fin.cast hlen i)⟩
    have he : List.ofFn a.2 = xs := by
      have h := List.ofFn_congr hlen (fun i => xs.get (Fin.cast hlen i))
      simpa [a] using h
    refine ⟨passiWordGenerator D hD u a,AddSubgroup.subset_closure ⟨a,rfl⟩,?_⟩
    change augmentationWord D u (List.ofFn a.2) = augmentationWord D u xs
    rw [he]
  apply top_le_iff.mp
  intro x _
  have hx : x.val ∈ positiveWordSpan D u := by rw [positiveWordSpan_eq_passi D hD u hu]; exact x.property
  obtain ⟨y,hy,he⟩ := hle hx
  have hyx : y = x := Subtype.ext he
  rwa [hyx] at hy

end DirectedCycles
