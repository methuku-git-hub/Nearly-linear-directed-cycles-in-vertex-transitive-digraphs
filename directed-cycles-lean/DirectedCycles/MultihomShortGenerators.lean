import DirectedCycles.MultihomBoxWidth

set_option autoImplicit false
open scoped Pointwise
namespace DirectedCycles.GroupMultihom

/-- The finite box decomposition used in the normal-envelope argument.
Each input is generated by a subgroup and k_i fixed elements. At least
one coordinate stays a subgroup coordinate in every box. -/
theorem range_width_of_subgroup_and_generators {ι : Type*} [Fintype ι] [DecidableEq ι]
    {B : ι → Type*} [∀ i, Group (B i)] [∀ i, Finite (B i)]
    {G : Type*} [CommGroup G] [Finite G]
    (φ : GroupMultihom B G) (H : ∀ i, Subgroup (B i)) (k : ι → ℕ)
    (f : ∀ i, Fin (k i) → B i)
    (hgen : ∀ i, Subgroup.closure ((H i : Set (B i)) ∪ Set.range (f i)) = ⊤)
    (hfree : ∃ i, k i = 0) (T : Subgroup G) (r M : ℕ) (hr : Group.rank T ≤ r)
    (A : Set G)
    (hT : ∀ x, (∀ i, x i ∈ H i ∨ x i ∈ Set.range (f i)) → φ x ∈ T)
    (hA : ∀ x, (∀ i, x i ∈ H i ∨ x i ∈ Set.range (f i)) → φ x ∈ A^M) :
    (Subgroup.closure (Set.range φ) : Set G) ⊆ A^((∏ i, (k i+1))*(M*r)) := by
  classical
  let J := ∀ i, Option (Fin (k i))
  let active : J → Set ι := fun t i => t i = none
  let fixed : J → ∀ i, B i := fun t i => (t i).elim 1 (f i)
  let τ : J → Type _ := fun t => active t
  let C : ∀ t : J, τ t → Type _ := fun _ i => H i.val
  have hnon : ∀ t : J, Nonempty (τ t) := by
    intro t
    obtain ⟨i,hi⟩ := hfree
    refine ⟨⟨i,?_⟩⟩
    change t i = none
    cases ht : t i with
    | none => rfl
    | some j => have := j.isLt; omega
  let : ∀ t, Nonempty (τ t) := hnon
  let ψ : ∀ t : J, GroupMultihom (C t) G := fun t =>
    (φ.partialEvaluation (active t) (fixed t)).subgroupDom (fun i : active t => H i.val)
  have hinputs : ∀ (t : J) (z : ∀ i, B i), (∀ i ∈ active t, z i ∈ H i) →
      (∀ i ∉ active t, z i = fixed t i) →
      ∀ i, z i ∈ H i ∨ z i ∈ Set.range (f i) := by
    intro t z hz hf i
    by_cases hi : i ∈ active t
    · exact Or.inl (hz i hi)
    · right
      rw [hf i hi]
      cases ht : t i with
      | none => exact False.elim (hi ht)
      | some j => exact ⟨j,by simp [fixed,ht]⟩
  have hrange : ∀ t, Set.range (ψ t) =
      φ '' {z | (∀ i ∈ active t, z i ∈ H i) ∧ (∀ i ∉ active t, z i = fixed t i)} :=
    fun t => partialEvaluation_subgroup_range φ (active t) (fixed t) H
  have hcover : ∀ x, (∀ i, x i ∈ (H i : Set (B i)) ∪ Set.range (f i)) →
      ∃ t : J, φ x ∈ Set.range (ψ t) := by
    intro x hx
    have hchoose : ∀ i, ∃ t : Option (Fin (k i)),
        (t = none → x i ∈ H i) ∧ (∀ j, t = some j → x i = f i j) := by
      intro i
      rcases hx i with hi | ⟨j,hj⟩
      · refine ⟨none,fun _ => hi,?_⟩
        intro j hj
        cases hj
      · refine ⟨some j,?_,?_⟩
        · intro h; cases h
        · intro l hl; cases hl; exact hj.symm
    choose t ht using hchoose
    refine ⟨t,?_⟩
    rw [hrange t]
    refine ⟨x,⟨?_,?_⟩,rfl⟩
    · intro i hi; exact (ht i).1 hi
    · intro i hi
      cases he : t i with
      | none => exact False.elim (hi he)
      | some j => simpa only [fixed,he,Option.elim_some] using (ht i).2 j he
  have hbound := range_width_of_finite_family φ
    (fun i => (H i : Set (B i)) ∪ Set.range (f i)) hgen τ C ψ hcover T
    (fun t => by rw [hrange t]; rintro g ⟨z,⟨hz,hf⟩,rfl⟩; exact hT z (hinputs t z hz hf))
    r M hr A
    (fun t => by rw [hrange t]; rintro g ⟨z,⟨hz,hf⟩,rfl⟩; exact hA z (hinputs t z hz hf))
  have hc : Fintype.card J = ∏ i, (k i+1) := by simp [J,Fintype.card_pi]
  simpa only [hc] using hbound

end DirectedCycles.GroupMultihom
