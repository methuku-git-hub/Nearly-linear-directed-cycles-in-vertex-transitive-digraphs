module

public import DirectedCycles.NormalizedBaseline
public import DirectedCycles.NormalizedLayerGeneration

@[expose] public section

set_option autoImplicit false
namespace DirectedCycles

/-- The canonical finite index of a cyclic position. -/
def coordinateIndex {G : Type*} (xs : List G) [NeZero xs.length]
    (i : ZMod xs.length) : Fin xs.length := ⟨i.val,ZMod.val_lt i⟩

@[simp] theorem coordinateIndex_natCast {G : Type*} (xs : List G) [NeZero xs.length]
    (j : Fin xs.length) : coordinateIndex xs (j.val : ZMod xs.length) = j := by
  apply Fin.ext
  exact ZMod.val_natCast_of_lt j.isLt

/-- Available coordinate labels are the images of the actual available words. -/
def normalizedLabelSet {G : Type*} [Group G] (xs : List G) [NeZero xs.length]
    (S : ZMod xs.length → Set G) (i : ZMod xs.length) : Set G :=
  coordinateLabel xs (coordinateIndex xs i) '' S i

/-- The normalized baseline is an allowed round in the actual coordinate system. -/
theorem normalizedCoordinate_baseline_allowed {G : Type*} [Group G]
    (xs : List G) [NeZero xs.length] (S : ZMod xs.length → Set G)
    (hxs : LayerWord S 0 xs) : LayerWord (normalizedLabelSet xs S) 0 (normalizedBaseline xs) := by
  apply (layerWord_iff_get _ _ _).mpr
  intro j
  have hj : j.val < xs.length := by simpa only [normalizedBaseline_length] using j.isLt
  let k : Fin xs.length := ⟨j.val,hj⟩
  have he : (normalizedBaseline xs)[j.val] = coordinateLabel xs k xs[j.val] := by
    simp only [normalizedBaseline,List.getElem_ofFn]
    rfl
  rw [he]
  change coordinateLabel xs k xs[j.val] ∈ coordinateLabel xs (coordinateIndex xs (0+j.val)) '' S (0+j.val)
  simp only [zero_add]
  have hidx : coordinateIndex xs (j.val : ZMod xs.length) = k := coordinateIndex_natCast xs k
  rw [hidx]
  refine ⟨xs[j.val],?_,rfl⟩
  simpa only [zero_add] using (layerWord_iff_get S 0 xs).mp hxs k

/-- Coordinate normalization constructs a strongly connected graph on the
subgroup generated by its full rounds. -/
theorem normalizedCoordinate_stronglyConnected {G : Type*} [Group G] [Finite G]
    (xs : List G) [NeZero xs.length] (S : ZMod xs.length → Set G)
    (hxs : LayerWord S 0 xs) :
    StronglyConnected (CyclicLayerDigraph (restrictedLayerLabels (normalizedLabelSet xs S)
      (Subgroup.closure (layerRoundProducts (normalizedLabelSet xs S))))) := by
  apply normalizedLayer_stronglyConnected (normalizedLabelSet xs S) (normalizedBaseline xs)
    (normalizedBaseline_length xs) (normalizedCoordinate_baseline_allowed xs S hxs)
  intro j hj
  exact normalizedBaseline_prefix xs j (by simpa only [normalizedBaseline_length] using hj)

/-- The full-round subgroup lies in the intended normal fibre whenever all
alternatives agree with their baseline modulo that fibre. -/
theorem normalizedCoordinate_group_le {G : Type*} [Group G]
    (N : Subgroup G) [N.Normal] (xs : List G) [NeZero xs.length]
    (S : ZMod xs.length → Set G) (hprod : xs.prod ∈ N)
    (hS : ∀ i, ∀ a ∈ S i,
      QuotientGroup.mk' N a = QuotientGroup.mk' N xs[(coordinateIndex xs i).val]) :
    Subgroup.closure (layerRoundProducts (normalizedLabelSet xs S)) ≤ N := by
  have hlabels : ∀ i, normalizedLabelSet xs S i ⊆ N := by
    intro i a ha
    obtain ⟨b,hb,rfl⟩ := ha
    exact coordinateLabel_mem_normal N xs hprod (coordinateIndex xs i) b (hS i b hb)
  apply N.closure_le.mpr
  rintro g ⟨ys,_,hys,rfl⟩
  apply Subgroup.list_prod_mem
  intro a ha
  obtain ⟨j,hj⟩ := List.mem_iff_get.mp ha
  have h := (layerWord_iff_get (normalizedLabelSet xs S) 0 ys).mp hys j
  rw [List.get_eq_getElem] at hj
  rw [hj] at h
  exact hlabels _ h

end DirectedCycles
