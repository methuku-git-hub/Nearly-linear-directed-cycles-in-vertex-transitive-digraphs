import DirectedCycles.Basic
import Mathlib.Data.ZMod.Basic
import Mathlib.GroupTheory.Rank

set_option autoImplicit false
open scoped Classical
namespace DirectedCycles

/-- An abelian group generated by r elements of exponent dividing e has
at most e^r elements. The surjection from (Z/eZ)^r is constructed explicitly. -/
theorem abelian_card_le_exponent_pow_generators {A ι : Type*} [AddCommGroup A]
    [Fintype A] [Fintype ι] (v : ι → A)
    (hv : AddSubgroup.closure (Set.range v) = ⊤) (e : ℕ) (he : 0 < e)
    (hexp : ∀ i, e • v i = 0) : Fintype.card A ≤ e ^ Fintype.card ι := by
  let : NeZero e := ⟨by omega⟩
  let f : ι → (ZMod e →+ A) := fun i => ZMod.lift e
    ⟨{ toFun := fun z => z • v i
       map_zero' := zero_zsmul _
       map_add' := fun x y => add_zsmul (v i) x y }, by simpa using hexp i⟩
  let F : (ι → ZMod e) →+ A := {
    toFun := fun w => ∑ i, f i (w i)
    map_zero' := by simp
    map_add' := by intro x y; simp only [Pi.add_apply, map_add, Finset.sum_add_distrib] }
  have hgen : ∀ i, v i ∈ F.range := by
    intro i
    refine ⟨Pi.single i 1, ?_⟩
    change (∑ j, f j ((Pi.single i 1 : ι → ZMod e) j)) = v i
    rw [Finset.sum_eq_single i]
    · simp only [Pi.single_eq_same]
      calc f i 1 = f i ((1 : ℤ) : ZMod e) := by norm_num
           _ = (1 : ℤ) • v i := ZMod.lift_coe e _ _
           _ = v i := one_zsmul _
    · intro j _ hji
      rw [Pi.single_eq_of_ne hji, map_zero]
    · simp
  have hs : Function.Surjective F := AddMonoidHom.range_eq_top.mp (by
    apply top_unique
    rw [← hv]
    exact F.range.closure_le.mpr (by rintro _ ⟨i, rfl⟩; exact hgen i))
  have hcard := Fintype.card_le_of_surjective F hs
  simpa only [Fintype.card_fun, ZMod.card] using hcard

/-- The multiplicative form using the minimum generator count. -/
theorem finite_abelian_card_le_exponent_rank {G : Type*} [CommGroup G] [Fintype G]
    (e : ℕ) (he : 0 < e) (hexp : ∀ x : G, x ^ e = 1) :
    Fintype.card G ≤ e ^ Group.rank G := by
  obtain ⟨S, hScard, hS⟩ := Group.rank_spec G
  let v : S → Additive G := fun x => Additive.ofMul x.val
  have hv : AddSubgroup.closure (Set.range v) = ⊤ := by
    have hr : Set.range v = Additive.toMul ⁻¹' (S : Set G) := by
      ext x
      constructor
      · rintro ⟨y, rfl⟩
        exact y.property
      · intro hx
        exact ⟨⟨x.toMul, hx⟩, rfl⟩
    rw [hr, ← Subgroup.toAddSubgroup_closure, hS]
    rfl
  have hexp' : ∀ i : S, e • v i = 0 := fun i => congrArg Additive.ofMul (hexp i.val)
  have h := abelian_card_le_exponent_pow_generators v hv e he hexp'
  simpa only [Fintype.card_coe, hScard, Fintype.card_additive] using h

end DirectedCycles
