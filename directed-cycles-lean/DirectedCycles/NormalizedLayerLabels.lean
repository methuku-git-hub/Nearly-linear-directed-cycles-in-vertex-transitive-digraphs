import DirectedCycles.LayerWordReplacement

set_option autoImplicit false
namespace DirectedCycles

/-- If every proper prefix product is one, each baseline label is either one
or the complete baseline product. -/
theorem normalizedBaseline_label {G : Type*} [Group G] (xs : List G)
    (hp : ∀ j < xs.length, (xs.take j).prod = 1) (j : ℕ) (hj : j < xs.length) :
    xs[j] = 1 ∨ xs[j] = xs.prod := by
  have he : (xs.take (j+1)).prod = xs[j] := by
    rw [← List.take_concat_get' xs j hj,List.prod_append,List.prod_singleton,hp j hj,one_mul]
  by_cases hs : j+1 < xs.length
  · exact Or.inl (he.symm.trans (hp (j+1) hs))
  · have hj' : j+1 = xs.length := by omega
    rw [hj',List.take_length] at he
    exact Or.inr he.symm

/-- All labels belong to the group generated by full rounds when the baseline
is normalized. This is the containment required to restrict to C × Z/TZ. -/
theorem normalizedLayer_labels_mem {G : Type*} [Group G] {T : ℕ} [NeZero T]
    (S : ZMod T → Set G) (xs : List G) (hlen : xs.length = T) (hxs : LayerWord S 0 xs)
    (hp : ∀ j < xs.length, (xs.take j).prod = 1) :
    ∀ i : ZMod T, ∀ a ∈ S i, a ∈ Subgroup.closure (layerRoundProducts S) := by
  intro i a ha
  let C := Subgroup.closure (layerRoundProducts S)
  have hi : i.val < xs.length := by rw [hlen]; exact ZMod.val_lt i
  have hprod : xs.prod ∈ C := Subgroup.subset_closure ⟨xs,hlen,hxs,rfl⟩
  have hb : xs[i.val] ∈ C := by
    rcases normalizedBaseline_label xs hp i.val hi with he | he
    · rw [he]; exact C.one_mem
    · rw [he]; exact hprod
  have hallowed : LayerWord S 0 (xs.set i.val a) :=
    layerWord_set S 0 xs hxs i.val a (by simpa using ha)
  have hnew : (xs.set i.val a).prod ∈ C := Subgroup.subset_closure
    ⟨xs.set i.val a,by simpa using hlen,hallowed,rfl⟩
  have he := list_product_replacement xs i.val hi a
  rw [hp i.val hi,one_mul,inv_one,mul_one] at he
  rw [he] at hnew
  have h := C.mul_mem (C.mul_mem hnew (C.inv_mem hprod)) hb
  simpa only [mul_inv_cancel_right,inv_mul_cancel_right] using h

/-- Normalized baseline data supply an available label at every layer. -/
theorem normalizedLayer_nonempty {G : Type*} [Group G] {T : ℕ} [NeZero T]
    (S : ZMod T → Set G) (xs : List G) (hlen : xs.length = T) (hxs : LayerWord S 0 xs) :
    ∀ i : ZMod T, (S i).Nonempty := by
  intro i
  have hi : i.val < xs.length := by rw [hlen]; exact ZMod.val_lt i
  refine ⟨xs[i.val],?_⟩
  simpa using (layerWord_iff_get S 0 xs).mp hxs ⟨i.val,hi⟩

end DirectedCycles
