module

public import Mathlib.Topology.Sets.VietorisTopology
public import Mathlib.Topology.Algebra.Group.ClosedSubgroup
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.Tactic

@[expose] public section

set_option autoImplicit false
open TopologicalSpace Filter
open scoped Topology Pointwise
namespace DirectedCycles
variable {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- Actual multiplication of compact group subsets. -/
def compactWindowProduct (A B : Compacts G) : Compacts G :=
  (A ×ˢ B).map (fun p => p.1*p.2) continuous_mul

theorem compactWindowProduct_coe (A B : Compacts G) :
    (compactWindowProduct A B : Set G) = (A : Set G)*(B : Set G) := by
  ext x
  simp only [compactWindowProduct,Compacts.coe_map,Compacts.coe_prod,Set.mem_image,
    Set.mem_prod,Set.mem_mul]
  constructor
  · rintro ⟨⟨a,b⟩,⟨ha,hb⟩,he⟩
    exact ⟨a,ha,b,hb,he⟩
  · rintro ⟨a,ha,b,hb,he⟩
    exact ⟨(a,b),⟨ha,hb⟩,he⟩

theorem compactWindowProduct_continuous :
    Continuous (fun p : Compacts G × Compacts G => compactWindowProduct p.1 p.2) :=
  continuous_mul.compacts_map.comp Compacts.continuous_prod

/-- Actual finite powers in the compact-set space. -/
def compactWindowPower (A : Compacts G) : ℕ → Compacts G
  | 0 => {1}
  | n+1 => compactWindowProduct (compactWindowPower A n) A

theorem compactWindowPower_coe (A : Compacts G) (n : ℕ) :
    (compactWindowPower A n : Set G) = (A : Set G)^n := by
  induction n with
  | zero => rfl
  | succ n ih => rw [compactWindowPower,compactWindowProduct_coe,ih,pow_succ]

theorem compactWindowPower_continuous (n : ℕ) :
    Continuous (fun A : Compacts G => compactWindowPower A n) := by
  induction n with
  | zero => exact continuous_const
  | succ n ih => exact compactWindowProduct_continuous.comp (ih.prodMk continuous_id)

/-- Inversion is continuous on the compact-set space. -/
def compactWindowInverse (A : Compacts G) : Compacts G := A.map Inv.inv continuous_inv

theorem compactWindowInverse_coe (A : Compacts G) :
    (compactWindowInverse A : Set G) = (A : Set G)⁻¹ := by
  ext x
  simp [compactWindowInverse]

theorem compactWindowInverse_continuous : Continuous (compactWindowInverse (G := G)) :=
  continuous_inv.compacts_map

omit [Group G] [IsTopologicalGroup G] in
/-- Fixed-point membership persists in a compact-set limit. -/
theorem compact_limit_mem {ι : Type*} {l : Filter ι} [l.NeBot] [T2Space G]
    {A : ι → Compacts G} {E : Compacts G} (hlim : Tendsto A l (𝓝 E)) {x : G}
    (hx : ∀ᶠ i in l, x ∈ A i) : x ∈ E := by
  have hcl := Compacts.isClosed_inter_nonempty_of_isClosed (isClosed_singleton : IsClosed ({x} : Set G))
  have hmem : (E : Set G) ∩ {x} |>.Nonempty := hcl.mem_of_tendsto hlim
    (hx.mono (fun i hi => ⟨x,hi,rfl⟩))
  obtain ⟨y,hy,he⟩ := hmem
  have hey : y = x := he
  rw [← hey]
  exact hy

/-- Symmetry persists in the compact-set limit. -/
theorem compact_limit_symmetric {ι : Type*} {l : Filter ι} [l.NeBot] [T2Space G]
    {A : ι → Compacts G} {E : Compacts G} (hlim : Tendsto A l (𝓝 E))
    (hs : ∀ᶠ i in l, (A i : Set G)⁻¹ = (A i : Set G)) : (E : Set G)⁻¹ = (E : Set G) := by
  have hA : (fun i => compactWindowInverse (A i)) =ᶠ[l] A := hs.mono (fun i hi => by
    apply Compacts.ext
    rw [compactWindowInverse_coe,hi])
  have he := tendsto_nhds_unique ((compactWindowInverse_continuous.tendsto E).comp hlim)
    (hlim.congr' hA.symm)
  have hc := congrArg (fun K : Compacts G => (K : Set G)) he
  simpa only [compactWindowInverse_coe] using hc

/-- Eventual bounds on every finite power pass to the compact-set limit. -/
theorem compact_limit_power_subset {ι : Type*} {l : Filter ι} [l.NeBot]
    {A : ι → Compacts G} {E : Compacts G} (hlim : Tendsto A l (𝓝 E))
    {B : Set G} (hB : IsClosed B) (n : ℕ)
    (hpow : ∀ᶠ i in l, (A i : Set G)^n ⊆ B) : (E : Set G)^n ⊆ B := by
  have h := (Compacts.isClosed_subsets_of_isClosed hB).mem_of_tendsto
    ((compactWindowPower_continuous n).tendsto E |>.comp hlim)
    (hpow.mono (fun i hi => by
      change (compactWindowPower (A i) n : Set G) ⊆ B
      rw [compactWindowPower_coe]
      exact hi))
  change (compactWindowPower E n : Set G) ⊆ B at h
  rw [compactWindowPower_coe] at h
  exact h

omit [TopologicalSpace G] [IsTopologicalGroup G] in
/-- Every element of the subgroup generated by a symmetric set is in
one actual finite word power of that same set. -/
theorem subgroup_closure_mem_word_power {E : Set G} (hEi : E⁻¹ = E)
    {x : G} (hx : x ∈ Subgroup.closure E) : ∃ n : ℕ, x ∈ E^n := by
  induction hx using Subgroup.closure_induction with
  | mem x hx => exact ⟨1,by simpa only [pow_one] using hx⟩
  | one => exact ⟨0,by simp⟩
  | mul x y _ _ hx hy =>
      obtain ⟨m,hm⟩ := hx
      obtain ⟨n,hn⟩ := hy
      exact ⟨m+n,by rw [pow_add]; exact Set.mul_mem_mul hm hn⟩
  | inv x _ hx =>
      obtain ⟨n,hn⟩ := hx
      exact ⟨n,by simpa only [← inv_pow,hEi] using Set.inv_mem_inv.mpr hn⟩

/-- A symmetric compact-set limit with all finite powers in one compact
region generates an actual compact subgroup in that same region. -/
theorem compact_subgroup_of_bounded_word_powers [T2Space G]
    {E B : Set G} (hEi : E⁻¹ = E) (hB : IsCompact B)
    (hpow : ∀ n : ℕ, E^n ⊆ B) :
    IsCompact (Subgroup.topologicalClosure (Subgroup.closure E) : Set G) ∧
      (Subgroup.topologicalClosure (Subgroup.closure E) : Set G) ⊆ B := by
  have hEB : (Subgroup.closure E : Set G) ⊆ B := by
    intro x hx
    obtain ⟨n,hn⟩ := subgroup_closure_mem_word_power hEi hx
    exact hpow n hn
  have hclosed : (Subgroup.topologicalClosure (Subgroup.closure E) : Set G) ⊆ B :=
    closure_minimal hEB hB.isClosed
  exact ⟨hB.of_isClosed_subset isClosed_closure hclosed,hclosed⟩
end DirectedCycles
