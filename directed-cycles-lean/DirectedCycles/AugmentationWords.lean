import DirectedCycles.TruncatedExpansion
import Mathlib.GroupTheory.OrderOfElement

set_option autoImplicit false
open scoped BigOperators
namespace DirectedCycles

noncomputable def augmentationWord {G : Type*} [Group G] (D : ℕ)
    {ι : Type*} (u : ι → G) (xs : List ι) : TruncatedGroupRing G D :=
  (xs.map (fun i => truncatedElement G D (u i)-1)).prod

noncomputable def positiveWordSpan {G : Type*} [Group G] (D : ℕ)
    {ι : Type*} (u : ι → G) : AddSubgroup (TruncatedGroupRing G D) :=
  AddSubgroup.closure {x | ∃ xs : List ι, 0 < xs.length ∧ xs.length < D ∧ augmentationWord D u xs = x}

theorem augmentationWord_cons {G : Type*} [Group G] (D : ℕ)
    {ι : Type*} (u : ι → G) (i : ι) (xs : List ι) :
    augmentationWord D u (i::xs) =
      (truncatedElement G D (u i)-1) * augmentationWord D u xs := rfl

theorem augmentationWord_zero {G : Type*} [Group G] (D : ℕ)
    {ι : Type*} (u : ι → G) (xs : List ι) (hlen : xs.length = D) :
    augmentationWord D u xs = 0 := by
  have h := truncated_difference_product D (xs.map u) (by simpa using hlen)
  simpa [augmentationWord,List.map_map,Function.comp_def] using h

/-- Prepending a generator difference either gives another short positive
word or a vanishing product of D augmentation differences. -/
theorem positiveWordSpan_difference_mul {G : Type*} [Group G] (D : ℕ)
    {ι : Type*} (u : ι → G) (i : ι) (x : TruncatedGroupRing G D)
    (hx : x ∈ positiveWordSpan D u) :
    (truncatedElement G D (u i)-1)*x ∈ positiveWordSpan D u := by
  induction hx using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨xs,hpos,hlt,rfl⟩ := hx
    rw [← augmentationWord_cons]
    by_cases hnext : (i::xs).length < D
    · exact AddSubgroup.subset_closure ⟨i::xs,by simp,hnext,rfl⟩
    · have heq : (i::xs).length = D := by simp only [List.length_cons] at *; omega
      rw [augmentationWord_zero D u _ heq]
      exact (positiveWordSpan D u).zero_mem
  | zero => simpa only [mul_zero] using (positiveWordSpan D u).zero_mem
  | add x y _ _ hx hy => simpa only [mul_add] using (positiveWordSpan D u).add_mem hx hy
  | neg x _ hx => simpa only [mul_neg] using (positiveWordSpan D u).neg_mem hx

theorem generator_difference_mem_positiveWordSpan {G : Type*} [Group G]
    (D : ℕ) (hD : 0 < D) {ι : Type*} (u : ι → G) (i : ι) :
    truncatedElement G D (u i)-1 ∈ positiveWordSpan D u := by
  by_cases h : 1 < D
  · apply AddSubgroup.subset_closure
    exact ⟨[i],by simp,by simpa using h,by simp [augmentationWord]⟩
  · have he : D = 1 := by omega
    subst D
    have hz := truncated_difference_pow 1 (u i)
    rw [pow_one] at hz
    rw [hz]
    exact (positiveWordSpan 1 u).zero_mem

/-- Generator differences of arbitrary group elements are generated by
positive words of lengths 1 through D-1 in the chosen generator differences. -/
theorem all_differences_mem_positiveWordSpan {G : Type*} [Group G] [Finite G]
    (D : ℕ) (hD : 0 < D) {ι : Type*} (u : ι → G)
    (hu : Subgroup.closure (Set.range u) = ⊤) (g : G) :
    truncatedElement G D g-1 ∈ positiveWordSpan D u := by
  have hm : Submonoid.closure (Set.range u) = ⊤ := by
    rw [← Subgroup.closure_toSubmonoid_of_finite,hu,Subgroup.top_toSubmonoid]
  induction g using Submonoid.induction_of_closure_eq_top_left hm with
  | one => simpa only [map_one,sub_self] using (positiveWordSpan D u).zero_mem
  | mul_left g hg x hx =>
    obtain ⟨i,rfl⟩ := hg
    have hi := generator_difference_mem_positiveWordSpan D hD u i
    have hp := positiveWordSpan_difference_mul D u i _ hx
    have he : truncatedElement G D (u i*x)-1 =
        (truncatedElement G D (u i)-1) + (truncatedElement G D x-1) +
          (truncatedElement G D (u i)-1)*(truncatedElement G D x-1) := by
      rw [map_mul]
      noncomm_ring
    rw [he]
    exact (positiveWordSpan D u).add_mem ((positiveWordSpan D u).add_mem hi hx) hp

end DirectedCycles
