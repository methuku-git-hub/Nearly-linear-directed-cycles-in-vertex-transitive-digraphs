import DirectedCycles.NormalClosureCommutators
import DirectedCycles.TerminalCommutatorMaps

set_option autoImplicit false
open scoped commutatorElement
namespace DirectedCycles
namespace MarkedCommutatorWord

/-- A left-nested commutator with the listed ordinary inputs in reverse order. -/
def leftList {α : Type*} : List α → MarkedCommutatorWord α
  | [] => .marked
  | i::l => .left (leftList l) (.var i)

@[simp] theorem leftList_degree {α : Type*} (l : List α) :
    (leftList l).degree = l.length := by
  induction l with
  | nil => rfl
  | cons i l ih => simp only [leftList,degree,CommutatorWord.weight,List.length_cons,ih]

@[simp] theorem leftList_leafLabels {α : Type*} (l : List α) :
    (leftList l).leafLabels = l.reverse := by
  induction l with
  | nil => rfl
  | cons i l ih => simp only [leftList,leafLabels,CommutatorWord.leafLabels,ih,List.reverse_cons]

/-- Distinct labels let the ordinary entries vary independently; the
values are exactly the iterated commutator set. -/
theorem leftList_values {α : Type*} [DecidableEq α] {G : Type*} [Group G]
    (S : Set G) (l : List α) (hl : l.Nodup) :
    iteratedCommutatorValues S l.length =
      {z | ∃ h ∈ S, ∃ x : α → G, (leftList l).eval h x = z} := by
  induction l with
  | nil =>
    ext z
    constructor
    · intro hz; exact ⟨z,hz,fun _ => 1,rfl⟩
    · rintro ⟨h,hh,x,rfl⟩; exact hh
  | cons i l ih =>
    obtain ⟨hnot,hnodup⟩ := List.nodup_cons.mp hl
    rw [List.length_cons,iteratedCommutatorValues]
    ext z
    constructor
    · rintro ⟨a,ha,g,rfl⟩
      rw [ih hnodup] at ha
      obtain ⟨h,hh,x,rfl⟩ := ha
      refine ⟨h,hh,Function.update x i g,?_⟩
      change ⁅(leftList l).eval h (Function.update x i g),Function.update x i g i⁆ = _
      rw [Function.update_self,eval_update_of_not_mem]
      simpa only [leftList_leafLabels,List.mem_reverse] using hnot
    · rintro ⟨h,hh,x,rfl⟩
      refine ⟨(leftList l).eval h x,?_,x i,rfl⟩
      rw [ih hnodup]
      exact ⟨h,hh,x,rfl⟩

/-- The last relative term is generated by one explicit left-nested form;
it is unnecessary to take a union over all binary commutator forms. -/
theorem closure_leftList_values {α : Type*} [DecidableEq α] {G : Type*} [Group G]
    (S : Set G) (l : List α) (hl : l.Nodup)
    (hnext : relativeSeries (Subgroup.normalClosure S) (l.length+1) = ⊥) :
    Subgroup.closure {z | ∃ h ∈ S, ∃ x : α → G, (leftList l).eval h x = z} =
      relativeSeries (Subgroup.normalClosure S) l.length := by
  rw [← leftList_values S l hl]
  exact closure_iteratedCommutatorValues_of_central S l.length
    (relativeSeries_central_of_next_eq_bot _ _ hnext)

end MarkedCommutatorWord
end DirectedCycles
