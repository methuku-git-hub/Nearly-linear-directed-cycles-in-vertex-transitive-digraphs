module

public import Mathlib.Combinatorics.Additive.RuzsaCovering
public import DirectedCycles.AbelianShortGeneration

@[expose] public section

set_option autoImplicit false
open scoped Pointwise
namespace DirectedCycles

/-- The finite, qualitative part of the contained Green--Ruzsa model that
this proof needs, proved by finite_abelian_large_model. B is a dense short
subset generated by a short subgroup and a bounded list of short elements;
the unconditional proof is assembled in FiniteStructuralTheorems. -/
def FiniteAbelianLargeModel : Prop :=
  ∀ K : ℝ, 1 ≤ K → ∃ r M : ℕ, 1 ≤ M ∧
    ∀ (G : Type) [CommGroup G] [Finite G] (A : Set G),
      IsApproximateSubgroup K A →
      ∃ (H : Subgroup G) (F : Finset G) (B : Set G),
        (H : Set G) ⊆ A^4 ∧ (F : Set G) ⊆ A^4 ∧ F.card ≤ r ∧
        B ⊆ A^4 ∧ B ⊆ Subgroup.closure ((H : Set G) ∪ (F : Set G)) ∧
        Nat.card A ≤ M * Nat.card B

theorem approximate_set_card_pow {G : Type*} [Group G] [Finite G]
    (A : Set G) (K : ℝ) (hA : IsApproximateSubgroup K A) (n : ℕ) :
    (Nat.card ↥(A^n) : ℝ) ≤ K^(n-1)*Nat.card A := by
  classical
  let : Fintype G := Fintype.ofFinite G
  let F := A.toFinset
  have hF : (F : Set G) = A := Set.coe_toFinset A
  have he1 : Nat.card A = F.card := by rw [← hF,Nat.card_coe_set_eq,Set.ncard_coe_finset]
  have hen : Nat.card ↥(A^n) = (F^n).card := by
    rw [← hF,← Finset.coe_pow,Nat.card_coe_set_eq,Set.ncard_coe_finset]
  have hh : IsApproximateSubgroup K (F : Set G) := hF.symm ▸ hA
  simpa only [he1,hen] using hh.card_pow_le (n := n)

/-- A dense subset of A^4 yields a bounded translate cover of A. -/
theorem dense_short_set_cover {G : Type*} [Group G] [Finite G]
    (A B : Set G) (K : ℝ) (M : ℕ) (hA : IsApproximateSubgroup K A)
    (hBA : B ⊆ A^4) (hdensity : Nat.card A ≤ M*Nat.card B) :
    ∃ X : Set G, X ⊆ A ∧ (Nat.card X : ℝ) ≤ K^4*(M : ℝ) ∧ A ⊆ X*(B/B) := by
  let C := K^4*(M : ℝ)
  have hcA : 0 < Nat.card A := by
    let : Nonempty A := ⟨⟨1,hA.one_mem⟩⟩
    exact Nat.card_pos
  have hcB : 0 < Nat.card B := by nlinarith
  have hBnon : B.Nonempty := (Set.ncard_pos B.toFinite).mp (by simpa only [Nat.card_coe_set_eq] using hcB)
  have hsub : A*B ⊆ A^5 := by
    calc A*B ⊆ A*(A^4) := Set.mul_subset_mul_left hBA
         _ = A^5 := by rw [← pow_succ']
  have hcsub : (Nat.card ↥(A*B) : ℝ) ≤ Nat.card ↥(A^5) := by
    exact_mod_cast Set.ncard_le_ncard hsub
  have hden : (Nat.card A : ℝ) ≤ (M : ℝ)*Nat.card B := by exact_mod_cast hdensity
  have hcov : (Nat.card ↥(A*B) : ℝ) ≤ C*Nat.card B := by
    calc
      (Nat.card ↥(A*B) : ℝ) ≤ K^4*Nat.card A := by
        exact hcsub.trans (by simpa using approximate_set_card_pow A K hA 5)
      _ ≤ K^4*((M : ℝ)*Nat.card B) := mul_le_mul_of_nonneg_left hden (by positivity)
      _ = C*Nat.card B := by dsimp [C]; ring
  obtain ⟨X,hXA,hXcard,hcover,hXfinite⟩ := Set.ruzsa_covering_mul A.toFinite B.toFinite hBnon hcov
  exact ⟨X,hXA,hXcard,hcover⟩

/-- Ruzsa covering alone is enough for the qualitative short-generator
input. The full Chang argument and a containing coset progression are not
needed for this finite route. -/
theorem abelian_short_generation_of_large_model (hModel : FiniteAbelianLargeModel) :
    FiniteAbelianShortGeneration := by
  classical
  intro K hK
  obtain ⟨r,M,_hM,hmodel⟩ := hModel K hK
  let C := K^4*(M : ℝ)
  refine ⟨r+⌈C⌉₊,?_⟩
  intro G _ _ A hA hgen
  obtain ⟨H,F,B,hH,hF,hcard,hBA,hBgen,hdensity⟩ := hmodel G A hA
  obtain ⟨X,hXA,hXcard,hcover⟩ := dense_short_set_cover A B K M hA hBA hdensity
  have hXfinite : X.Finite := X.toFinite
  let E := hXfinite.toFinset
  have hE : (E : Set G) = X := hXfinite.coe_toFinset
  have hEc : E.card ≤ ⌈C⌉₊ := by
    have hc : (E.card : ℝ) ≤ C := by
      simpa only [← hE,Nat.card_coe_set_eq,Set.ncard_coe_finset] using hXcard
    exact_mod_cast hc.trans (Nat.le_ceil C)
  refine ⟨H,F ∪ E,hH,?_,(Finset.card_union_le F E).trans (Nat.add_le_add hcard hEc),?_⟩
  · intro g hg
    rcases Finset.mem_union.mp hg with hg | hg
    · exact hF hg
    · exact Set.subset_pow hA.one_mem (by norm_num : 4 ≠ 0) (hXA (hE ▸ hg))
  · let N := Subgroup.closure ((H : Set G) ∪ ((F ∪ E : Finset G) : Set G))
    have hBN : B ⊆ N := hBgen.trans (Subgroup.closure_mono (by
      intro g hg
      rcases hg with hg | hg
      · exact Or.inl hg
      · exact Or.inr (Finset.mem_union_left E hg)))
    have hXN : X ⊆ N := by
      intro g hg
      apply Subgroup.subset_closure
      exact Or.inr (Finset.mem_union_right F (by simpa only [← hE,Finset.mem_coe] using hg))
    have hAN : A ⊆ N := by
      intro a ha
      obtain ⟨x,hx,y,hy,rfl⟩ := hcover ha
      obtain ⟨b,hb,c,hc,rfl⟩ := hy
      exact N.mul_mem (hXN hx) (N.div_mem (hBN hb) (hBN hc))
    apply top_unique
    rw [← hgen]
    exact N.closure_le.mpr hAN

end DirectedCycles
