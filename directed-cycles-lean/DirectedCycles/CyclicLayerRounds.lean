module

public import DirectedCycles.CyclicLayerConnectivity

@[expose] public section

set_option autoImplicit false
namespace DirectedCycles

theorem layerWord_append {G : Type*} [Group G] {T : ℕ}
    (S : ZMod T → Set G) (i : ZMod T) (xs ys : List G) :
    LayerWord S i (xs++ys) ↔ LayerWord S i xs ∧ LayerWord S (i+xs.length) ys := by
  induction xs generalizing i with
  | nil => simp [LayerWord]
  | cons a xs ih =>
    simp only [List.cons_append,LayerWord,ih,List.length_cons,Nat.cast_add,Nat.cast_one]
    constructor
    · rintro ⟨ha,hxs,hys⟩
      exact ⟨⟨ha,hxs⟩,by simpa only [add_assoc,add_comm,add_left_comm] using hys⟩
    · rintro ⟨⟨ha,hxs⟩,hys⟩
      exact ⟨ha,hxs,by simpa only [add_assoc,add_comm,add_left_comm] using hys⟩

/-- Every path carries an ordered list of its actual arc labels. -/
theorem cyclicLayer_reachable_word {G : Type*} [Group G] {T : ℕ}
    (S : ZMod T → Set G) {x y : G × ZMod T} (h : Reachable (CyclicLayerDigraph S) x y) :
    ∃ xs : List G, LayerWord S x.2 xs ∧ y.2 = x.2+xs.length ∧ y.1 = x.1*xs.prod := by
  induction h with
  | refl => exact ⟨[],trivial,by simp,by simp⟩
  | @tail y z h hyz ih =>
    obtain ⟨xs,hxs,hi,hg⟩ := ih
    obtain ⟨hzi,a,ha,hza⟩ := hyz
    refine ⟨xs++[a],(layerWord_append S _ _ _).mpr ⟨hxs,?_⟩,?_,?_⟩
    · exact ⟨hi ▸ ha,trivial⟩
    · simp only [List.length_append,List.length_singleton,Nat.cast_add,Nat.cast_one]
      rw [hzi,hi,add_assoc]
    · simp only [List.prod_append,List.prod_singleton]
      rw [hza,hg,mul_assoc]

/-- A word of an integral number of rounds has product in the subgroup
generated by the full-round products. -/
theorem layerWord_rounds_mem {G : Type*} [Group G] {T : ℕ}
    (S : ZMod T → Set G) (k : ℕ) (xs : List G)
    (hlen : xs.length = T*k) (hxs : LayerWord S 0 xs) :
    xs.prod ∈ Subgroup.closure (layerRoundProducts S) := by
  induction k generalizing xs with
  | zero =>
    have he : xs = [] := List.length_eq_zero_iff.mp (by simpa using hlen)
    rw [he,List.prod_nil]
    exact (Subgroup.closure _).one_mem
  | succ k ih =>
    have hT : T ≤ xs.length := by rw [hlen,Nat.mul_succ]; omega
    have htake : (xs.take T).length = T := by simp [List.length_take,Nat.min_eq_left hT]
    have hdrop : (xs.drop T).length = T*k := by simp only [List.length_drop,hlen,Nat.mul_succ]; omega
    have hw : LayerWord S 0 (xs.take T++xs.drop T) := by rwa [List.take_append_drop]
    obtain ⟨hw1,hw2⟩ := (layerWord_append S 0 _ _).mp hw
    rw [htake,ZMod.natCast_self,zero_add] at hw2
    have hm1 : (xs.take T).prod ∈ Subgroup.closure (layerRoundProducts S) :=
      Subgroup.subset_closure ⟨xs.take T,htake,hw1,rfl⟩
    have h := (Subgroup.closure (layerRoundProducts S)).mul_mem hm1 (ih _ hdrop hw2)
    rwa [← List.prod_append,List.take_append_drop] at h

/-- Strong connectivity forces full-round products to generate the group. -/
theorem cyclicLayer_rounds_generate {G : Type*} [Group G] {T : ℕ}
    (S : ZMod T → Set G) (h : StronglyConnected (CyclicLayerDigraph S)) :
    Subgroup.closure (layerRoundProducts S) = ⊤ := by
  apply top_unique
  intro g _
  obtain ⟨xs,hxs,hlen,hg⟩ := cyclicLayer_reachable_word S (h (1,0) (g,0))
  have hcast : (xs.length : ZMod T) = 0 := by simpa using hlen.symm
  have hdiv : T ∣ xs.length := (ZMod.natCast_eq_zero_iff xs.length T).mp hcast
  obtain ⟨k,hk⟩ := hdiv
  have hp := layerWord_rounds_mem S k xs hk hxs
  have hge : g = xs.prod := by simpa only [one_mul] using hg
  rw [hge]
  exact hp

end DirectedCycles
