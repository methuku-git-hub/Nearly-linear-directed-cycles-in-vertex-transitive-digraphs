module

public import DirectedCycles.FullCosetSpanning
public import DirectedCycles.TranslatedConsecutivePowers

@[expose] public section

set_option autoImplicit false
namespace DirectedCycles

/-- D consecutive powers span the truncation of a group generated by that
element. This also covers D=0, where the quotient ring is zero. -/
theorem cyclic_consecutive_powers_spanning {G : Type*} [Group G] (D : ℕ) (a : G)
    (ha : Subgroup.zpowers a = ⊤) :
    SpansTruncation D (Set.range (fun i : Fin D => a^i.val)) := by
  let E := Set.range (fun i : Fin D => a^i.val)
  let W := AddSubgroup.closure (truncatedElement G D '' E)
  have hh : ∀ i : ℕ, i < D → truncatedElement G D (a^(0+(i : ℤ))) ∈ W := by
    intro i hi
    rw [zero_add,zpow_natCast]
    exact AddSubgroup.subset_closure ⟨a^i,⟨⟨i,hi⟩,rfl⟩,rfl⟩
  have hall : ∀ x : G, truncatedElement G D x ∈ W := by
    intro x
    have hx : x ∈ Subgroup.zpowers a := ha ▸ Subgroup.mem_top x
    obtain ⟨k,rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
    exact truncated_consecutive_powers_mem D a W 0 hh k
  apply top_le_iff.mp
  rw [← truncated_elements_generate (G := G) D]
  exact W.closure_le.mpr (by rintro x ⟨g,rfl⟩; exact hall g)

/-- Complete fibres over D consecutive powers of a cyclic quotient suffice
for integral additive generation, without any density approximation. -/
theorem cyclic_quotient_full_cosets_span {G : Type*} [CommGroup G]
    (H : Subgroup G) (D : ℕ) (y : G)
    (hy : Subgroup.zpowers (QuotientGroup.mk' H y) = ⊤) (E : Set G)
    (hE : ∀ i : ℕ, i < D → ∀ u : H, y^i*u.val ∈ E) : SpansTruncation D E := by
  let W := AddSubgroup.closure (truncatedElement G D '' E)
  apply spanning_of_full_cosets H D (fun i : Fin D => y^i.val) W
  · simpa only [map_pow] using cyclic_consecutive_powers_spanning D (QuotientGroup.mk' H y) hy
  · intro i u
    exact AddSubgroup.subset_closure ⟨u.val*y^i.val,by rw [mul_comm]; exact hE i.val i.isLt u,rfl⟩

end DirectedCycles
