import DirectedCycles.LocalEquivalenceWindow
import DirectedCycles.LocalProductSwap
import DirectedCycles.LocalDivision

set_option autoImplicit false
namespace DirectedCycles
namespace LocalGroupAlgebra
variable {G : Type*} (L : LocalGroupAlgebra G)

/-- The precise closure needed for a central local quotient. P is allowed
to be a short progression; it is not required to be a global subgroup. -/
structure CentralLocalSet (P V S : Set G) : Prop where
  one_mem : L.one ∈ P
  inv_mem : ∀ p ∈ P, L.inv p ∈ P
  mul_mem : ∀ p ∈ P, ∀ q ∈ P, ∀ z ∈ V, L.mulRel p q z → z ∈ P
  central : ∀ p ∈ P, ∀ x ∈ S, L.Commute p x

namespace CentralLocalSet
variable {L} {P V S : Set G} (C : L.CentralLocalSet P V S)
    (hd : L.DivisionClosed) (hr : L.Reversible)
    (hS1 : L.one ∈ S) (hSi : ∀ x ∈ S, L.inv x ∈ S)
    (hdom : L.AllProductsDefined S 8) (hSV : L.wordPower S 8 ⊆ V)

/-- The relation uses the actual difference in P, without taking the global
subgroup generated by P. -/
def Rel (_C : L.CentralLocalSet P V S) (a b : G) : Prop := ∃ p ∈ P, L.mulRel a (L.inv b) p

include C in
theorem rel_refl (a : G) : C.Rel a a := ⟨L.one,C.one_mem,L.mul_inv a⟩

include C hr in
theorem rel_symm {a b : G} (h : C.Rel a b) : C.Rel b a := by
  obtain ⟨p,hp,hm⟩ := h
  exact ⟨L.inv p,C.inv_mem p hp,by simpa only [L.inv_inv] using hr hm⟩

include C hS1 hSi hdom hSV in
theorem rel_trans {a b c : G} (ha : a ∈ S) (hb : b ∈ S) (hc : c ∈ S)
    (hab : C.Rel a b) (hbc : C.Rel b c) : C.Rel a c := by
  obtain ⟨p,hp,hab⟩ := hab
  obtain ⟨q,hq,hbc⟩ := hbc
  obtain ⟨r,hrp⟩ := hdom [a,L.inv c] (by simp) (by aesop)
  have hac := (Product.pair_iff L _ _ _).1 hrp
  have hrV : r ∈ V := hSV (L.wordPower_subset_wordPower hS1 hdom (by omega : 2 ≤ 8) le_rfl
    ⟨[a,L.inv c],rfl,by aesop,hrp⟩)
  obtain ⟨z,hz⟩ := hdom [a,L.inv b,b,L.inv c] (by simp) (by aesop)
  have hflat : L.Product ([[a,L.inv b],[b,L.inv c]] : List (List G)).flatten z := by simpa using hz
  have hblocks : List.Forall₂ L.Product [[a,L.inv b],[b,L.inv c]] [p,q] :=
    List.Forall₂.cons ((Product.pair_iff L _ _ _).2 hab)
      (List.Forall₂.cons ((Product.pair_iff L _ _ _).2 hbc) List.Forall₂.nil)
  have hpq := (Product.pair_iff L _ _ _).1 (hflat.compress L hblocks)
  have hcancel : L.Product ([a] ++ [L.inv b,b] ++ [L.inv c]) z := hz
  have hzshort := hcancel.cancel_inv_pair L ⟨r,hrp⟩
  have he : z = r := hzshort.unique L hrp
  exact ⟨r,C.mul_mem p hp q hq r hrV (he ▸ hpq),hac⟩

include C hd hr in
theorem rel_inv {a b : G} (hb : b ∈ S) (hab : C.Rel a b) : C.Rel (L.inv a) (L.inv b) := by
  obtain ⟨p,hp,hm⟩ := hab
  have hpb : L.mulRel p b a := by simpa only [L.inv_inv] using hd.right hm
  obtain ⟨z,hpz,hbpz⟩ := C.central p hp b hb
  have he : z = a := L.unique hpz hpb
  have hbp : L.mulRel b p a := he ▸ hbpz
  have hia : L.mulRel (L.inv b) a p := hd.left hbp
  refine ⟨L.inv p,C.inv_mem p hp,?_⟩
  simpa only [L.inv_inv] using hr hia
include C hd hS1 hSi hdom hSV in
/-- Multiplication of equivalence classes is compatible wherever both
source products are defined. Every auxiliary product has a certified
8-letter domain in S. -/
theorem rel_mul {a b c a' b' c' : G}
    (ha : a ∈ S) (hb : b ∈ S) (ha' : a' ∈ S) (hb' : b' ∈ S)
    (hm : L.mulRel a b c) (hm' : L.mulRel a' b' c')
    (haa' : C.Rel a a') (hbb' : C.Rel b b') : C.Rel c c' := by
  obtain ⟨p,hp,hpa'⟩ := haa'
  obtain ⟨q,hq,hqb'⟩ := hbb'
  have hpa : L.mulRel p a' a := by simpa only [L.inv_inv] using hd.right hpa'
  have hqb : L.mulRel q b' b := by simpa only [L.inv_inv] using hd.right hqb'
  have hp2 : p ∈ L.wordPower S 2 :=
    ⟨[a,L.inv a'],rfl,by aesop,(Product.pair_iff L _ _ _).2 hpa'⟩
  have hq2 : q ∈ L.wordPower S 2 :=
    ⟨[b,L.inv b'],rfl,by aesop,(Product.pair_iff L _ _ _).2 hqb'⟩
  have hs2 : S ⊆ L.wordPower S 2 := by
    intro x hx
    apply L.wordPower_subset_wordPower hS1 hdom (by omega : 1 ≤ 2) (by omega)
    simpa only [L.wordPower_one] using hx
  have hdom2 := hdom.wordPower L (by omega : 2*4 ≤ 8)
  obtain ⟨z,hz⟩ := hdom2 [p,a',q,b'] (by simp) (by aesop)
  obtain ⟨w,hw⟩ := hdom2 [p,q,a',b'] (by simp) (by aesop)
  have hb1 : List.Forall₂ L.Product [[p,a'],[q,b']] [a,b] :=
    List.Forall₂.cons ((Product.pair_iff L _ _ _).2 hpa)
      (List.Forall₂.cons ((Product.pair_iff L _ _ _).2 hqb) List.Forall₂.nil)
  have hzflat : L.Product ([[p,a'],[q,b']] : List (List G)).flatten z := by simpa using hz
  have hez : z = c := L.unique ((Product.pair_iff L _ _ _).1 (hzflat.compress L hb1)) hm
  have hswap : L.Commute a' q := by
    obtain ⟨v,hqv,hvq⟩ := C.central q hq a' ha'
    exact ⟨v,hvq,hqv⟩
  have hew : w = c := (Product.swap_pair_value L hswap
    (a := [p]) (b := [b']) hz hw).symm.trans hez
  obtain ⟨r,hrp⟩ := hdom2 [p,q] (by simp) (by aesop)
  have hpqr := (Product.pair_iff L _ _ _).1 hrp
  have hr4 : r ∈ L.wordPower S 4 := by
    rw [show 4 = 2+2 by rfl,L.wordPower_add hdom (by omega : 2+2 ≤ 8)]
    exact ⟨p,hp2,q,hq2,hpqr⟩
  have hrV : r ∈ V := hSV (L.wordPower_subset_wordPower hS1 hdom (by omega : 4 ≤ 8) le_rfl hr4)
  have hb2 : List.Forall₂ L.Product [[p,q],[a',b']] [r,c'] :=
    List.Forall₂.cons hrp (List.Forall₂.cons ((Product.pair_iff L _ _ _).2 hm') List.Forall₂.nil)
  have hwflat : L.Product ([[p,q],[a',b']] : List (List G)).flatten w := by simpa using hw
  have hrc : L.mulRel r c' c := hew ▸ (Product.pair_iff L _ _ _).1 (hwflat.compress L hb2)
  exact ⟨r,C.mul_mem p hp q hq r hrV hpqr,hd.right hrc⟩

/-- A central locally closed set supplies the actual larger-window
equivalence used by the small local quotient construction. -/
def equivalenceWindow : L.EquivalenceWindow S where
  Rel := C.Rel
  refl := fun a _ => C.rel_refl a
  symm := fun _ _ _ _ h => C.rel_symm hr h
  trans := fun _ ha _ hb _ hc h h' => C.rel_trans hS1 hSi hdom hSV ha hb hc h h'
  inv_rel := fun _ _ _ hb h => C.rel_inv hd hr hb h
  mul_rel := fun _ ha _ hb _ _ _ ha' _ hb' _ _ hm hm' h h' =>
    C.rel_mul hd hS1 hSi hdom hSV ha hb ha' hb' hm hm' h h'
end CentralLocalSet
end LocalGroupAlgebra
end DirectedCycles
