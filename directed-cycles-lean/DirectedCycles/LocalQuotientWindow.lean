import DirectedCycles.LocalGroupAlgebra
import Mathlib.Algebra.Group.Pointwise.Set.Basic

set_option autoImplicit false
open scoped Pointwise
namespace DirectedCycles
variable {G : Type*} [Group G]

/-- Conditions sufficient for quotienting inside a small window. The set P may
extend beyond V; closure and conjugation are required whenever the result lies
in V. The quotient proofs below do not require P to be a global subgroup. -/
structure LocalNormalSet (P V : Set G) : Prop where
  one_mem : (1 : G) ∈ P
  inv_mem : ∀ x ∈ P, x⁻¹ ∈ P
  mul_mem : ∀ x ∈ P, ∀ y ∈ P, x*y ∈ V → x*y ∈ P
  conj_mem : ∀ x ∈ V, ∀ p ∈ P, x*p*x⁻¹ ∈ V → x*p*x⁻¹ ∈ P

namespace LocalNormalSet
variable {P V W : Set G} (hP : LocalNormalSet P V)
    (hW1 : (1 : G) ∈ W) (hWi : W⁻¹ = W) (hW6 : W^6 ⊆ V)

include hWi in
theorem window_inv_mem {x : G} (hx : x ∈ W) : x⁻¹ ∈ W := by
  have h : x⁻¹ ∈ W⁻¹ := Set.inv_mem_inv.mpr hx
  simpa only [hWi] using h

include hW1 hW6 in
theorem window_pow_mem {n : ℕ} (hn : n ≤ 6) {x : G} (hx : x ∈ W^n) : x ∈ V :=
  hW6 ((Set.pow_subset_pow_right hW1 hn) hx)

include hW1 hW6 in
theorem window_mem {x : G} (hx : x ∈ W) : x ∈ V :=
  window_pow_mem hW1 hW6 (n := 1) (by omega) (by simpa using hx)

include hW1 hW6 in
theorem window_mul_mem {x y : G} (hx : x ∈ W) (hy : y ∈ W) : x*y ∈ V := by
  apply window_pow_mem hW1 hW6 (n := 2) (by omega)
  rw [pow_two]
  exact Set.mul_mem_mul hx hy

include hW1 hW6 in
theorem window_four_mem {a b c d : G} (ha : a ∈ W) (hb : b ∈ W) (hc : c ∈ W) (hd : d ∈ W) :
    a*b*c*d ∈ V := by
  apply window_pow_mem hW1 hW6 (n := 4) (by omega)
  have h2 : a*b ∈ W^2 := by rw [pow_two]; exact Set.mul_mem_mul ha hb
  have h3 : a*b*c ∈ W^3 := by rw [show 3=2+1 by rfl,pow_succ]; exact Set.mul_mem_mul h2 hc
  rw [show 4=3+1 by rfl,pow_succ]
  exact Set.mul_mem_mul h3 hd

/-- The local coset relation on the window. It uses membership in P itself,
not membership in the global subgroup generated by P. -/
def windowSetoid : Setoid W where
  r a b := a.val*b.val⁻¹ ∈ P
  iseqv := {
    refl := fun a => by simpa using hP.one_mem
    symm := by
      intro a b hab
      have h := hP.inv_mem _ hab
      simpa only [mul_inv_rev,inv_inv] using h
    trans := by
      intro a b c hab hbc
      have hv : a.val*b.val⁻¹*(b.val*c.val⁻¹) ∈ V := by
        simpa [mul_assoc] using window_mul_mem hW1 hW6 a.property (window_inv_mem hWi c.property)
      simpa [mul_assoc] using hP.mul_mem _ hab _ hbc hv }

theorem window_inverse_respects {a b : W} (hab : (hP.windowSetoid hW1 hWi hW6).r a b) :
    a.val⁻¹*b.val ∈ P := by
  have hp : b.val*a.val⁻¹ ∈ P := by
    simpa only [mul_inv_rev,inv_inv] using hP.inv_mem _ hab
  have hbi := window_inv_mem hWi b.property
  have hai := window_inv_mem hWi a.property
  have hv : b.val⁻¹*(b.val*a.val⁻¹)*(b.val⁻¹)⁻¹ ∈ V := by
    simpa [mul_assoc] using window_mul_mem hW1 hW6 hai b.property
  simpa [mul_assoc] using hP.conj_mem _ (window_mem hW1 hW6 hbi) _ hp hv

theorem window_multiplication_respects {a b c d : W}
    (hac : (hP.windowSetoid hW1 hWi hW6).r a c)
    (hbd : (hP.windowSetoid hW1 hWi hW6).r b d) :
    (a.val*b.val)*(c.val*d.val)⁻¹ ∈ P := by
  have hci := window_inv_mem hWi c.property
  have hdi := window_inv_mem hWi d.property
  have hvconj : c.val*(b.val*d.val⁻¹)*c.val⁻¹ ∈ V := by
    simpa [mul_assoc] using window_four_mem hW1 hW6 c.property b.property hdi hci
  have hpconj := hP.conj_mem _ (window_mem hW1 hW6 c.property) _ hbd hvconj
  have hprod : (a.val*c.val⁻¹)*(c.val*(b.val*d.val⁻¹)*c.val⁻¹) ∈ V := by
    simpa [mul_assoc] using window_four_mem hW1 hW6 a.property b.property hdi hci
  have hh := hP.mul_mem _ hac _ hpconj hprod
  simpa [mul_inv_rev,mul_assoc] using hh

abbrev WindowQuotient := Quotient (hP.windowSetoid hW1 hWi hW6)

theorem window_quotient_eq_iff (a b : W) :
    Quotient.mk (hP.windowSetoid hW1 hWi hW6) a = Quotient.mk (hP.windowSetoid hW1 hWi hW6) b ↔
      a.val*b.val⁻¹ ∈ P := Quotient.eq
end LocalNormalSet
end DirectedCycles
