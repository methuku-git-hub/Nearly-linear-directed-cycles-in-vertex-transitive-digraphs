module

public import DirectedCycles.PrimaryMultihomWidth
public import DirectedCycles.FiniteSylowModel

@[expose] public section

set_option autoImplicit false
open scoped Pointwise
namespace DirectedCycles.GroupMultihom

/-- Finite Tointon Proposition 6.1: the subgroup generated by a separately
homomorphic image in a finite abelian group has width at most the ambient rank.
All primary components are assembled at each product position, so no loss
depending on the number of primes occurs. -/
theorem finite_nilpotent_range_width {ι : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι]
    {B : ι → Type*} [∀ i, Group (B i)] [∀ i, Finite (B i)] [∀ i, Group.IsNilpotent (B i)]
    {G : Type*} [CommGroup G] [Finite G] (φ : GroupMultihom B G) :
    (Subgroup.closure (Set.range φ) : Set G) ⊆ (Set.range φ)^(Group.rank G) := by
  classical
  let s : Finset ℕ := (Nat.card G).primeFactors ∪ Finset.univ.biUnion (fun i => (Nat.card (B i)).primeFactors)
  have hs : ∀ p ∈ s, p.Prime := by
    intro p hp
    rcases Finset.mem_union.mp hp with hp | hp
    · exact Nat.prime_of_mem_primeFactors hp
    · obtain ⟨i,_,hi⟩ := Finset.mem_biUnion.mp hp
      exact Nat.prime_of_mem_primeFactors hi
  have hGcontains : (Nat.card G).primeFactors ⊆ s := Finset.subset_union_left
  have hBcontains : ∀ i, (Nat.card (B i)).primeFactors ⊆ s := by
    intro i p hp
    exact Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨i,Finset.mem_univ i,hp⟩)
  let C : ι → s → Type _ := fun i p => (default : Sylow p.val (B i))
  let H : s → Type _ := fun p => (default : Sylow p.val G)
  let eB : ∀ i, (∀ p, C i p) ≃* B i := fun i => finiteSylowModel (B i) s hs (hBcontains i)
  let eG : (∀ p, H p) ≃* G := finiteSylowModel G s hs hGcontains
  let ψ := (φ.domComp (fun i => (eB i).toMonoidHom)).codComp eG.symm.toMonoidHom
  have hrange : Set.range ψ = eG.symm.toMonoidHom '' Set.range φ := by
    rw [range_codComp,range_domComp φ (fun i => (eB i).toMonoidHom)
      (fun i => (eB i).surjective)]
  have hC : ∀ i p, IsPGroup p.val (C i p) := fun i p => (default : Sylow p.val (B i)).isPGroup'
  have hH : ∀ p, IsPGroup p.val (H p) := fun p => (default : Sylow p.val G).isPGroup'
  have hr : ∀ p, Group.rank (H p) ≤ Group.rank G :=
    fun p => finite_abelian_subgroup_rank_le (default : Sylow p.val G).toSubgroup
  have hwidth := primary_product_range_width Subtype.val (fun p => hs p.val p.property)
    Subtype.val_injective hC hH (Group.rank G) hr ψ
  intro g hg
  have hm : eG.symm g ∈ Subgroup.closure (Set.range ψ) := by
    rw [hrange,← MonoidHom.map_closure]
    exact ⟨g,hg,rfl⟩
  have hh := hwidth hm
  rw [hrange] at hh
  have himage : eG.symm g ∈ eG.symm.toMonoidHom '' ((Set.range φ)^(Group.rank G)) := by
    simpa only [Set.image_pow] using hh
  obtain ⟨a,ha,hea⟩ := himage
  have he : a = g := eG.symm.injective hea
  simpa only [he] using ha

end DirectedCycles.GroupMultihom
