import DirectedCycles.NormalizedLayerLabels

set_option autoImplicit false
namespace DirectedCycles

/-- Restriction of a label system to a subgroup containing all its labels. -/
def restrictedLayerLabels {G : Type*} [Group G] {T : ℕ}
    (S : ZMod T → Set G) (C : Subgroup G) : ZMod T → Set C := fun i => {a | a.val ∈ S i}

/-- An allowed word lifts to the containing subgroup with the same actual labels. -/
theorem layerWord_lift_subgroup {G : Type*} [Group G] {T : ℕ}
    (S : ZMod T → Set G) (C : Subgroup G) (hC : ∀ i, S i ⊆ C)
    (i : ZMod T) (xs : List G) (hxs : LayerWord S i xs) :
    ∃ ys : List C, LayerWord (restrictedLayerLabels S C) i ys ∧ ys.map C.subtype = xs := by
  induction xs generalizing i with
  | nil => exact ⟨[],trivial,rfl⟩
  | cons a xs ih =>
    obtain ⟨ys,hys,he⟩ := ih (i+1) hxs.2
    refine ⟨⟨a,hC i hxs.1⟩::ys,⟨hxs.1,hys⟩,?_⟩
    change a :: ys.map C.subtype = a :: xs
    rw [he]

/-- A subgroup word projects to the original label system. -/
theorem layerWord_map_subtype {G : Type*} [Group G] {T : ℕ}
    (S : ZMod T → Set G) (C : Subgroup G) (i : ZMod T) (ys : List C)
    (hys : LayerWord (restrictedLayerLabels S C) i ys) : LayerWord S i (ys.map C.subtype) := by
  induction ys generalizing i with
  | nil => trivial
  | cons a ys ih => exact ⟨hys.1,ih (i+1) hys.2⟩

/-- Full-round products in the restricted group have exactly the original image. -/
theorem restrictedLayer_roundProducts_image {G : Type*} [Group G] {T : ℕ}
    (S : ZMod T → Set G) (C : Subgroup G) (hC : ∀ i, S i ⊆ C) :
    C.subtype '' layerRoundProducts (restrictedLayerLabels S C) = layerRoundProducts S := by
  ext g
  constructor
  · rintro ⟨b,⟨ys,hlen,hys,rfl⟩,rfl⟩
    refine ⟨ys.map C.subtype,by simpa using hlen,layerWord_map_subtype S C 0 ys hys,?_⟩
    exact (map_list_prod C.subtype ys).symm
  · rintro ⟨xs,hlen,hxs,rfl⟩
    obtain ⟨ys,hys,he⟩ := layerWord_lift_subgroup S C hC 0 xs hxs
    refine ⟨ys.prod,⟨ys,?_,hys,rfl⟩,?_⟩
    · have h := congrArg List.length he
      simpa only [List.length_map,hlen] using h
    · rw [map_list_prod,he]

/-- The subgroup generated by the rounds has a generating restricted round system. -/
theorem restrictedLayer_rounds_generate {G : Type*} [Group G] {T : ℕ}
    (S : ZMod T → Set G) (C : Subgroup G) (hC : ∀ i, S i ⊆ C)
    (hgen : Subgroup.closure (layerRoundProducts S) = C) :
    Subgroup.closure (layerRoundProducts (restrictedLayerLabels S C)) = ⊤ := by
  apply Subgroup.map_injective C.subtype_injective
  rw [MonoidHom.map_closure,restrictedLayer_roundProducts_image S C hC,hgen,
    Subgroup.map_top,Subgroup.subtype_range]

/-- The normalized auxiliary layer graph over the round subgroup is strongly
connected. All label containment and generation conditions are derived. -/
theorem normalizedLayer_stronglyConnected {G : Type*} [Group G] [Finite G]
    {T : ℕ} [NeZero T] (S : ZMod T → Set G)
    (xs : List G) (hlen : xs.length = T) (hxs : LayerWord S 0 xs)
    (hp : ∀ j < xs.length, (xs.take j).prod = 1) :
    StronglyConnected (CyclicLayerDigraph
      (restrictedLayerLabels S (Subgroup.closure (layerRoundProducts S)))) := by
  let C := Subgroup.closure (layerRoundProducts S)
  have hC := normalizedLayer_labels_mem S xs hlen hxs hp
  apply cyclicLayer_stronglyConnected
  · intro i
    obtain ⟨a,ha⟩ := normalizedLayer_nonempty S xs hlen hxs i
    exact ⟨⟨a,hC i a ha⟩,ha⟩
  · exact restrictedLayer_rounds_generate S C hC rfl

end DirectedCycles
